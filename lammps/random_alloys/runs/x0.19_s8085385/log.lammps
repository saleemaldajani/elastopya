variable C5pos equal ${d5}
variable C5pos equal -41.00144421057
variable C6pos equal ${d6}
variable C6pos equal 39.633920846553

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-90843.7155636051+${C1pos})
variable C13 equal 0.5*(-90843.7155636051+91160.5204107838)
