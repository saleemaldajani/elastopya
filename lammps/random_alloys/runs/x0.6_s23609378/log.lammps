variable pyz1 equal -4.02253414325624

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 169118.756735098
variable C2neg equal ${d2}
variable C2neg equal 168671.103187895
variable C3neg equal ${d3}
variable C3neg equal 170471.5223396
