variable pxz1 equal 3.50980359222297
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -10.2117984203411

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -66983.2828068167
variable C2neg equal ${d2}
variable C2neg equal -67134.349326637
variable C3neg equal ${d3}
variable C3neg equal -66906.414822716
