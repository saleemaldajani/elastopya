variable pxx1 equal -863.784587717929
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -856.991562595956
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -856.058077512239
