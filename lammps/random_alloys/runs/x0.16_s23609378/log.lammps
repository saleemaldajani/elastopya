variable C5pos equal ${d5}
variable C5pos equal 50.113702021822
variable C6pos equal ${d6}
variable C6pos equal 62.6684318442866

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-85665.5209998573+${C1pos})
variable C15 equal 0.5*(-85665.5209998573+85665.5188567206)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-86119.4940174922+${C2pos})
variable C25 equal 0.5*(-86119.4940174922+86119.5056880493)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-85864.3818956962+${C3pos})
variable C35 equal 0.5*(-85864.3818956962+85864.3826033044)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
