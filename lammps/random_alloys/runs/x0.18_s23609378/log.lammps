variable C5pos equal -79.893663659597
variable C6pos equal ${d6}
variable C6pos equal 107.441922986245

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-91339.0772492004+${C1pos})
variable C13 equal 0.5*(-91339.0772492004+91654.3709440184)
