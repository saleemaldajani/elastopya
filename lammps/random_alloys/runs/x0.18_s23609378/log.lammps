variable pxz1 equal -0.110231352414327
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 9.37298862079693

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -91496.7224887471
variable C2neg equal ${d2}
variable C2neg equal -91824.8334325273
variable C3neg equal ${d3}
variable C3neg equal -91328.1529499765
