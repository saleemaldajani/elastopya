RELAXED_BOX 142.894535085866 142.893746186033 142.893259850923

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-7.57983649939331)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-7.57983649939331)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-10.4667454658714)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-10.4667454658714)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-9.54060982002969)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-9.54060982002969)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
