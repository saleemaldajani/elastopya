variable C51 equal 0.5*(${C5neg}+${C5pos})
variable C51 equal 0.5*(-9.282662365852+${C5pos})
variable C51 equal 0.5*(-9.282662365852+9.28476021670805)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
