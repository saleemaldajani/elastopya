# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -1029302.1324749
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -337.518690567015
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -375.118063054372
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -326.932106669924
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -310.505901976749
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -0.136156221504434
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 5.54033139550886
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 3.98446510994032

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 50315.1319407781
variable C2pos equal ${d2}
variable C2pos equal 50427.9268971501
variable C3pos equal ${d3}
variable C3pos equal 50381.4473026181
variable C4pos equal ${d4}
variable C4pos equal -136.596212134149
variable C5pos equal ${d5}
variable C5pos equal 123.298688493946
variable C6pos equal ${d6}
variable C6pos equal -21.2089602647998

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-50315.1324906769+${C1pos})
variable C15 equal 0.5*(-50315.1324906769+50315.1319407781)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-50427.9286174307+${C2pos})
variable C25 equal 0.5*(-50427.9286174307+50427.9268971501)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-50381.4436668952+${C3pos})
variable C35 equal 0.5*(-50381.4436668952+50381.4473026181)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(136.597894827075+${C4pos})
variable C45 equal 0.5*(136.597894827075+-136.596212134149)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(104.731265948666+${C5pos})
variable C55 equal 0.5*(104.731265948666+123.298688493946)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
