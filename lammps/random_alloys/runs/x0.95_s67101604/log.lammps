variable pyz1 equal -2.50990811508013

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 55501.9153972455
variable C2neg equal ${d2}
variable C2neg equal 55242.4258766931
variable C3neg equal ${d3}
variable C3neg equal 54882.8837710768
