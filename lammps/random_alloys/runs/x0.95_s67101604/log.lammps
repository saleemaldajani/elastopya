variable pyz1 equal -1.42795207137447

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 55335.5500038586
variable C2neg equal ${d2}
variable C2neg equal 54932.3545452116
variable C3neg equal ${d3}
variable C3neg equal 54716.5448128673
