variable C5pos equal ${d5}
variable C5pos equal -112.835787797248
variable C6pos equal ${d6}
variable C6pos equal 61.490207531972

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(-109921.33350778+${C1pos})
variable C14 equal 0.5*(-109921.33350778+109921.330163409)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(-109635.614893727+${C2pos})
variable C24 equal 0.5*(-109635.614893727+109635.602143445)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(-109353.207005708+${C3pos})
variable C34 equal 0.5*(-109353.207005708+109353.18907071)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
