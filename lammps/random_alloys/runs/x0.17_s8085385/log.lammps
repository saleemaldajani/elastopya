variable pxz1 equal 0.321529942384988
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -1.25516995632127

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -109764.200565165
variable C2neg equal ${d2}
variable C2neg equal -109478.468389782
variable C3neg equal ${d3}
variable C3neg equal -109107.866118474
variable C4neg equal ${d4}
variable C4neg equal 246.424370008288
variable C5neg equal ${d5}
variable C5neg equal 112.826494219359
variable C6neg equal ${d6}
variable C6neg equal -61.498351206995

# Reset box and simulation parameters

clear
