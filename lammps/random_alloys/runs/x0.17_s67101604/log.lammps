variable C4pos equal -133.410353209455
variable C5pos equal ${d5}
variable C5pos equal 148.050100422266
variable C6pos equal ${d6}
variable C6pos equal 131.77426332691

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(-93316.2254306708+${C1pos})
variable C12 equal 0.5*(-93316.2254306708+93630.8459226527)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
