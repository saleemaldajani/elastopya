RELAXED_BOX 143.385758870973 143.380142639639 143.373518905671

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-310.610438513216)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-310.610438513216)/(v_delta/v_len0)*0.0001
