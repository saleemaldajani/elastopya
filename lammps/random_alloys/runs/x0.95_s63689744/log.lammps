# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -1021326.02940928
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 293.100598452037
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 189.948861093168
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 330.821469679073
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 358.531464583871
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 0.539979198797039
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 4.66602263052543
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 1.12486472100488

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -36449.0296679419
variable C2pos equal ${d2}
variable C2pos equal -36116.1864297104
variable C3pos equal ${d3}
variable C3pos equal -36137.9849327756
variable C4pos equal ${d4}
variable C4pos equal 10.136992778864
variable C5pos equal ${d5}
variable C5pos equal -0.419492201740024
variable C6pos equal ${d6}
variable C6pos equal 20.8756498612492

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(36781.7692688184+${C1pos})
variable C12 equal 0.5*(36781.7692688184+-36449.0296679419)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(36736.1062838926+${C2pos})
variable C22 equal 0.5*(36736.1062838926+-36116.1864297104)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(36470.6652559254+${C3pos})
variable C32 equal 0.5*(36470.6652559254+-36137.9849327756)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C42 equal 0.5*(${C4neg}+${C4pos})
variable C42 equal 0.5*(-10.137138899045+${C4pos})
variable C42 equal 0.5*(-10.137138899045+10.136992778864)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C52 equal 0.5*(${C5neg}+${C5pos})
variable C52 equal 0.5*(0.423372226781993+${C5pos})
variable C52 equal 0.5*(0.423372226781993+-0.419492201740024)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
