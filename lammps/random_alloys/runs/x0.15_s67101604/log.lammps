variable pxz1 equal 4.21644644315244
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 0.70291451757907

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -80743.2617631173
variable C2neg equal ${d2}
variable C2neg equal -81208.8806206029
variable C3neg equal ${d3}
variable C3neg equal -80947.1557934723
variable C4neg equal ${d4}
variable C4neg equal 111.928027961033
variable C5neg equal ${d5}
variable C5neg equal -255.643603925077
variable C6neg equal ${d6}
variable C6neg equal -120.243480944121

# Reset box and simulation parameters

clear
