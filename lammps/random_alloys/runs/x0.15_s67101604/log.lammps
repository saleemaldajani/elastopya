variable pxz1 equal 4.21637735964672
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 0.702855977948348

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -80832.5021418893
variable C2neg equal ${d2}
variable C2neg equal -81119.6143006889
variable C3neg equal ${d3}
variable C3neg equal -80947.1361218783
variable C4neg equal ${d4}
variable C4neg equal 111.922173997961
variable C5neg equal ${d5}
variable C5neg equal -255.650512275649
variable C6neg equal ${d6}
variable C6neg equal -120.244004576604

# Reset box and simulation parameters

clear
