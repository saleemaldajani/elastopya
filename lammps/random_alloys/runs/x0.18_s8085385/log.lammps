RELAXED_BOX 143.41026133434 143.403604933754 143.400313255833

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-330.312329121319)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-330.312329121319)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-355.299196235339)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-355.299196235339)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-394.742757891845)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-394.742757891845)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
