RELAXED_BOX 143.929811649915 143.93762744763 143.930156771129

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-1.40218027333356)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-1.40218027333356)/(v_delta/v_len0)*0.0001
