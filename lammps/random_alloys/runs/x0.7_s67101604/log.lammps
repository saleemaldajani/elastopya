variable C5pos equal ${d5}
variable C5pos equal 329.529134828776
variable C6pos equal ${d6}
variable C6pos equal -89.527472590112

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(192508.774196721+${C1pos})
variable C13 equal 0.5*(192508.774196721+-192167.588594752)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(191668.403761205+${C2pos})
variable C23 equal 0.5*(191668.403761205+-191327.196061367)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(192029.343353945+${C3pos})
variable C33 equal 0.5*(192029.343353945+-191487.111384817)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
