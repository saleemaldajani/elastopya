variable pxz1 equal -3.40836938702892
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -6.84198238412671

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 192338.172351652
variable C2neg equal ${d2}
variable C2neg equal 191497.796441399
variable C3neg equal ${d3}
variable C3neg equal 191758.222965913
