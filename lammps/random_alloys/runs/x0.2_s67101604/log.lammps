variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 143.48993828367
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 143.488578698609
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 143.489125277817
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 143.48993828367 143.488578698609 143.489125277817

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--24.650825471165)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--24.650825471165)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--37.0774713197415)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--37.0774713197415)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--36.6216958693615)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--36.6216958693615)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
