variable C5pos equal ${d5}
variable C5pos equal -109.962893356239
variable C6pos equal ${d6}
variable C6pos equal -81.9128619418128

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-51986.2986432295+${C1pos})
variable C13 equal 0.5*(-51986.2986432295+52286.3173003356)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-52102.2445412509+${C2pos})
variable C23 equal 0.5*(-52102.2445412509+52402.2688709607)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-52035.126044525+${C3pos})
variable C33 equal 0.5*(-52035.126044525+52523.9668390874)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
