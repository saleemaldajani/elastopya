RELAXED_BOX 143.452696127662 143.434090144421 143.446969517485

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--38.8677887909118)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--38.8677887909118)/(v_delta/v_len0)*0.0001
