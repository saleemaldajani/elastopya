variable pxz1 equal -2.90942194454695
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -1.24346527885986

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 53082.0894428783
variable C2neg equal ${d2}
variable C2neg equal 53412.2470401822
variable C3neg equal ${d3}
variable C3neg equal 52925.7200565871
variable C4neg equal ${d4}
variable C4neg equal -80.1768602938538
variable C5neg equal ${d5}
variable C5neg equal -5.69064591691801
variable C6neg equal ${d6}
variable C6neg equal 114.251053217114

# Reset box and simulation parameters

clear
