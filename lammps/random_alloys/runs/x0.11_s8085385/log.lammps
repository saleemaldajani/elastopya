variable pxz1 equal 8.64286795392916
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -1.57556954658566

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -74754.935250828
variable C2neg equal ${d2}
variable C2neg equal -74781.7484211989
variable C3neg equal ${d3}
variable C3neg equal -74708.1558594786
variable C4neg equal ${d4}
variable C4neg equal 241.005536566814
variable C5neg equal ${d5}
variable C5neg equal -42.563125450771
variable C6neg equal ${d6}
variable C6neg equal -112.95261907804

# Reset box and simulation parameters

clear
