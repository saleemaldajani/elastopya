# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -1028180.38001778
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -751.560344203784
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -752.76409366088
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -755.008607050448
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -746.908331900024
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 10.0728352658894
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 8.64281583531791
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -1.57539408976657

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 75062.0224221501
variable C2pos equal ${d2}
variable C2pos equal 75180.3023198246
variable C3pos equal ${d3}
variable C3pos equal 75106.6630438426
variable C4pos equal ${d4}
variable C4pos equal -241.023082248723
variable C5pos equal ${d5}
variable C5pos equal 42.5683373118961
variable C6pos equal ${d6}
variable C6pos equal 112.967416171

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-74754.9314746702+${C1pos})
variable C13 equal 0.5*(-74754.9314746702+75062.0224221501)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-74873.1744713013+${C2pos})
variable C23 equal 0.5*(-74873.1744713013+75180.3023198246)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-74616.7792204006+${C3pos})
variable C33 equal 0.5*(-74616.7792204006+75106.6630438426)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(241.00431083826+${C4pos})
variable C43 equal 0.5*(241.00431083826+-241.023082248723)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(-42.5565059799961+${C5pos})
variable C53 equal 0.5*(-42.5565059799961+42.5683373118961)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
