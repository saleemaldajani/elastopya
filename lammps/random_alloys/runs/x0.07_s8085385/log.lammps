variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C51 equal 0.5*(${C5neg}+${C5pos})
variable C51 equal 0.5*(19.814968215808+${C5pos})
variable C51 equal 0.5*(19.814968215808+-19.819440623053)
