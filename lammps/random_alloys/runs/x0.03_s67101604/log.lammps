variable C5pos equal ${d5}
variable C5pos equal 6.81586231031899
variable C6pos equal ${d6}
variable C6pos equal 36.496821907076

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-26192.0427164949+${C1pos})
variable C13 equal 0.5*(-26192.0427164949+26487.1983578341)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-26123.1769460621+${C2pos})
variable C23 equal 0.5*(-26123.1769460621+26418.3252902939)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-26034.1439792718+${C3pos})
variable C33 equal 0.5*(-26034.1439792718+26521.9885704225)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
