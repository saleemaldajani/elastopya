variable ly0 equal ${tmp}
variable ly0 equal 142.855341405082
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 142.855390046648
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 142.855479121133 142.855341405082 142.855390046648

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-1.06004628462623)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-1.06004628462623)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--1.24869024368307)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--1.24869024368307)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-0.0465634491714191)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-0.0465634491714191)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
