RELAXED_BOX 143.080990929285 143.082653628368 143.090072617862

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-13.7154889625461)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-13.7154889625461)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-10.3683817144977)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-10.3683817144977)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
