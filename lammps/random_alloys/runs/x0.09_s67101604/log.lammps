variable C5pos equal ${d5}
variable C5pos equal 169.066421439573
variable C6pos equal ${d6}
variable C6pos equal 7.18694878936406

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-54885.0110857524+${C1pos})
variable C13 equal 0.5*(-54885.0110857524+55189.507739946)
