variable pyz1 equal -1.34080409176946

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -48497.2188825589
variable C2neg equal ${d2}
variable C2neg equal -47182.0070460058
variable C3neg equal ${d3}
variable C3neg equal -46803.8603855328
