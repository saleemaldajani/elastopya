# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-0.00193274720039564)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-0.00193274720039564)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-0.00193274165232764)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-0.00193274165232764)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-0.00193276180789811)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-0.00193276180789811)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
variable d4 equal -(v_pyz1-2.67359047231679e-09)/(v_delta/v_len0)*${cfac}
variable d4 equal -(v_pyz1-2.67359047231679e-09)/(v_delta/v_len0)*0.0001
variable d5 equal -(v_pxz1-${pxz0})/(v_delta/v_len0)*${cfac}
