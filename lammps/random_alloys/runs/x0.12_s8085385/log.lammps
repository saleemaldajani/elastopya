variable pyz1 equal -2.14544910481135

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -70819.3768917311
variable C2neg equal ${d2}
variable C2neg equal -71124.5276609627
variable C3neg equal ${d3}
variable C3neg equal -70910.6438863701
