variable C5pos equal ${d5}
variable C5pos equal 44.7571496690211
variable C6pos equal ${d6}
variable C6pos equal 80.959939752127

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-70665.2959499791+${C1pos})
variable C13 equal 0.5*(-70665.2959499791+70973.4671224391)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-70970.4274800007+${C2pos})
variable C23 equal 0.5*(-70970.4274800007+71278.6464625157)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-70665.6573367501+${C3pos})
variable C33 equal 0.5*(-70665.6573367501+71155.6301840611)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
