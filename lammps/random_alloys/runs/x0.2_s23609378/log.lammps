RELAXED_BOX 143.459169213144 143.486655539558 143.490402166955

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-114.658466262536)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-114.658466262536)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-16.4595172453959)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-16.4595172453959)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
