variable C3pos equal ${d3}
variable C3pos equal 27745.0937551809
variable C4pos equal ${d4}
variable C4pos equal 71.0451750986427
variable C5pos equal ${d5}
variable C5pos equal -9.04748835661398
variable C6pos equal ${d6}
variable C6pos equal -35.617641579228

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(-27683.0126471625+${C1pos})
variable C14 equal 0.5*(-27683.0126471625+27683.0128891285)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(-27792.2143684376+${C2pos})
variable C24 equal 0.5*(-27792.2143684376+27792.2121389376)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(-27745.0993931338+${C3pos})
variable C34 equal 0.5*(-27745.0993931338+27745.0937551809)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
