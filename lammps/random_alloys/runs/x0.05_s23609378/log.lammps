RELAXED_BOX 142.96884759728 142.970648859054 142.902713265329

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--981.687030823785)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--981.687030823785)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--983.254504139834)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--983.254504139834)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--536.890699574366)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--536.890699574366)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
