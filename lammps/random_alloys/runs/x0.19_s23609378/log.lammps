RELAXED_BOX 143.444056026572 143.455334543796 143.447673532532

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--0.457903973299806)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--0.457903973299806)/(v_delta/v_len0)*0.0001
