variable C5pos equal ${d5}
variable C5pos equal 57.0023242667048
variable C6pos equal ${d6}
variable C6pos equal 51.742608537927

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(57013.5089935615+${C1pos})
variable C14 equal 0.5*(57013.5089935615+-57013.5015539081)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(56771.4596803984+${C2pos})
variable C24 equal 0.5*(56771.4596803984+-56771.4483091563)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(56735.2767692375+${C3pos})
variable C34 equal 0.5*(56735.2767692375+-56735.2659270099)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
