variable C5pos equal ${d5}
variable C5pos equal -33.9099377979299
variable C6pos equal ${d6}
variable C6pos equal -700.45544636488

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(173335.805969777+${C1pos})
variable C12 equal 0.5*(173335.805969777+-172995.929811303)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(175171.906420073+${C2pos})
variable C22 equal 0.5*(175171.906420073+-174651.021902081)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(171797.936677587+${C3pos})
variable C32 equal 0.5*(171797.936677587+-171458.110025364)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C42 equal 0.5*(${C4neg}+${C4pos})
variable C42 equal 0.5*(578.246150174778+${C4pos})
variable C42 equal 0.5*(578.246150174778+-578.296843410878)
