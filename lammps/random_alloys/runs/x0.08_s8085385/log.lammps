variable C43 equal 0.5*(233.411001963443+-233.420615108895)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(4.57876236344799+${C5pos})
variable C53 equal 0.5*(4.57876236344799+-4.57488805306596)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
