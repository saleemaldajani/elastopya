variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 143.904728518572
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 143.911469990272
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 143.927905100565
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 143.904728518572 143.911469990272 143.927905100565

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-386.998125647935)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-386.998125647935)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-410.873413725661)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-410.873413725661)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-294.748034690994)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-294.748034690994)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
variable d4 equal -(v_pyz1--1.95955560990461)/(v_delta/v_len0)*${cfac}
