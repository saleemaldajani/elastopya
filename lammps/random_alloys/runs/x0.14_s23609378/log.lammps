variable pxz1 equal -5.17590630375595
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -2.10006577477438

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -84182.6933656913
variable C2neg equal ${d2}
variable C2neg equal -84624.1592033482
variable C3neg equal ${d3}
variable C3neg equal -84162.9694596896
variable C4neg equal ${d4}
variable C4neg equal 82.478829193661
variable C5neg equal ${d5}
variable C5neg equal 43.8510324643651
