variable d2 equal -(v_pyy1-138.428277973351)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-207.472055661218)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-207.472055661218)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
