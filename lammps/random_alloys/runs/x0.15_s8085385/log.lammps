variable e1 equal -1025670.24836316
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -1378.37975328619
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -1389.16254119029
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -1390.83057713253
