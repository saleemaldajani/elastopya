variable pxz1 equal 0.274130759924346
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -9.28195683533146

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -86958.8800540534
variable C2neg equal ${d2}
variable C2neg equal -86982.0174153026
variable C3neg equal ${d3}
variable C3neg equal -87071.1191744255
variable C4neg equal ${d4}
variable C4neg equal 285.210923721044
variable C5neg equal ${d5}
variable C5neg equal 191.58611579312
variable C6neg equal ${d6}
variable C6neg equal 5.27856109749996

# Reset box and simulation parameters

clear
