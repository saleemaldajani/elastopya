RELAXED_BOX 143.325314978197 143.327610200943 143.323271379778

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--518.014869600776)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--518.014869600776)/(v_delta/v_len0)*0.0001
