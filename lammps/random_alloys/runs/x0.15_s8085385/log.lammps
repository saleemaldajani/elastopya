variable pxz1 equal 0.274112525892006
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -9.28197713411388

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -86958.8809999954
variable C2neg equal ${d2}
variable C2neg equal -87071.3069035246
variable C3neg equal ${d3}
variable C3neg equal -86981.9039341615
variable C4neg equal ${d4}
variable C4neg equal 285.208893842802
variable C5neg equal ${d5}
variable C5neg equal 191.584292389886
variable C6neg equal ${d6}
variable C6neg equal 5.27372058871896

# Reset box and simulation parameters

clear
