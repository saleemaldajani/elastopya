variable C4pos equal -76.571855412929
variable C5pos equal ${d5}
variable C5pos equal 106.49285177602
variable C6pos equal ${d6}
variable C6pos equal -320.933412155323

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(158696.067027571+${C1pos})
variable C13 equal 0.5*(158696.067027571+-158355.608098241)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(159636.262389627+${C2pos})
variable C23 equal 0.5*(159636.262389627+-159295.808508744)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(158993.402444682+${C3pos})
variable C33 equal 0.5*(158993.402444682+-158424.293782303)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
