variable C5pos equal ${d5}
variable C5pos equal 189.85116387603
variable C6pos equal ${d6}
variable C6pos equal 104.923978711824

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(-66780.4389838848+${C1pos})
variable C14 equal 0.5*(-66780.4389838848+66780.4291001226)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(-66997.4686799439+${C2pos})
variable C24 equal 0.5*(-66997.4686799439+66997.4508571548)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(-66986.8978264494+${C3pos})
variable C34 equal 0.5*(-66986.8978264494+66986.8813022148)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
