variable pyz1 equal 0.487920965046633

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -66625.2816126525
variable C2neg equal ${d2}
variable C2neg equal -66752.1767572022
variable C3neg equal ${d3}
variable C3neg equal -66831.7159403215
