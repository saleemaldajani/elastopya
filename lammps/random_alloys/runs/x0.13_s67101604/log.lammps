variable C5pos equal ${d5}
variable C5pos equal 189.85842624851
variable C6pos equal ${d6}
variable C6pos equal 104.922969018745

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(-66625.2816126525+${C1pos})
variable C12 equal 0.5*(-66625.2816126525+66935.5859985207)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(-66752.1767572022+${C2pos})
variable C22 equal 0.5*(-66752.1767572022+67242.742644818)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(-66831.7159403215+${C3pos})
variable C32 equal 0.5*(-66831.7159403215+67142.0627442017)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C42 equal 0.5*(${C4neg}+${C4pos})
