variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 142.869420340197
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 142.866285541658
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 142.863408696836
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 142.869420340197 142.866285541658 142.863408696836

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--440.194767549924)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--440.194767549924)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--417.16999880809)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--417.16999880809)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--394.684091234421)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--394.684091234421)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
variable d4 equal -(v_pyz1--1.17397580801276)/(v_delta/v_len0)*${cfac}
