# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -1025642.92599577
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -813.536804922492
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -806.930138063223
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -885.5735453588
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -748.106731345454
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -2.12635633934311
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -6.15121309628552
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 0.355973001188125

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 85394.0603952698
variable C2pos equal ${d2}
variable C2pos equal 85742.4813343399
variable C3pos equal ${d3}
variable C3pos equal 85542.521404391
variable C4pos equal ${d4}
variable C4pos equal -120.311648907062
variable C5pos equal ${d5}
variable C5pos equal -28.919279558773
variable C6pos equal ${d6}
variable C6pos equal 93.071858577909

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-85081.9722859152+${C1pos})
variable C13 equal 0.5*(-85081.9722859152+85394.0603952698)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-85430.3461190168+${C2pos})
variable C23 equal 0.5*(-85430.3461190168+85742.4813343399)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-85052.094888517+${C3pos})
variable C33 equal 0.5*(-85052.094888517+85542.521404391)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(120.287065364184+${C4pos})
variable C43 equal 0.5*(120.287065364184+-120.311648907062)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(28.925787643127+${C5pos})
variable C53 equal 0.5*(28.925787643127+-28.919279558773)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
