variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 3.93565470505437

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -42448.9955807733
variable C2neg equal ${d2}
variable C2neg equal -42361.1618134928
variable C3neg equal ${d3}
variable C3neg equal -42419.8548159864
variable C4neg equal ${d4}
variable C4neg equal -79.892853116652
