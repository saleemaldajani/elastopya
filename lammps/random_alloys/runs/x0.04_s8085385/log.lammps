variable C4pos equal 37.108757405604
variable C5pos equal ${d5}
variable C5pos equal -32.6210420859961
variable C6pos equal ${d6}
variable C6pos equal -67.5833712898102

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(-33486.7613241894+${C1pos})
variable C14 equal 0.5*(-33486.7613241894+33486.7568876951)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(-33435.8840708901+${C2pos})
variable C24 equal 0.5*(-33435.8840708901+33435.8755123176)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(-33399.888185942+${C3pos})
variable C34 equal 0.5*(-33399.888185942+33399.8780042387)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(193.323855142242+${C4pos})
variable C44 equal 0.5*(193.323855142242+37.108757405604)
