RELAXED_BOX 142.902340099737 142.90440451687 142.905467905613

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--486.388274072989)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--486.388274072989)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--494.71375454388)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--494.71375454388)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
