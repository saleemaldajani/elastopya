# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -1008735.06876222
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 1135.89943703442
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 1163.67145430119
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 1135.01001841982
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 1109.01683838224
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -1.106972931853
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -6.14225641774949
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -2.07306631781199

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -113527.186385832
variable C2pos equal ${d2}
variable C2pos equal -111181.088689767
variable C3pos equal ${d3}
variable C3pos equal -113141.815788776
variable C4pos equal ${d4}
variable C4pos equal 125.370258555534
variable C5pos equal ${d5}
variable C5pos equal -106.303745851336
variable C6pos equal ${d6}
variable C6pos equal -99.416923331268

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(113527.174939346+${C1pos})
variable C15 equal 0.5*(113527.174939346+-113527.186385832)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(111181.068584075+${C2pos})
variable C25 equal 0.5*(111181.068584075+-111181.088689767)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(113141.812556748+${C3pos})
variable C35 equal 0.5*(113141.812556748+-113141.815788776)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(-125.374068760295+${C4pos})
variable C45 equal 0.5*(-125.374068760295+125.370258555534)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(317.472741072018+${C5pos})
variable C55 equal 0.5*(317.472741072018+-106.303745851336)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
