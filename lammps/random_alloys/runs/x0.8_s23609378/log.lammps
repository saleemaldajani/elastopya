print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 143.811328418566 143.78648919585 143.784345502996

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--618.55838777512)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--618.55838777512)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--437.570546602719)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--437.570546602719)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--407.492688775561)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--407.492688775561)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
