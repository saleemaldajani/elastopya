variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 143.4875930349
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 143.482255983908
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 143.479530115117
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 143.4875930349 143.482255983908 143.479530115117

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--11.7390095351514)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--11.7390095351514)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-13.8472652585309)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-13.8472652585309)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-5.57736254316414)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-5.57736254316414)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
