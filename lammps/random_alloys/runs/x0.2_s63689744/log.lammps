variable C31 equal 0.5*(${C3neg}+${C3pos})
variable C31 equal 0.5*(-91170.7001792607+${C3pos})
variable C31 equal 0.5*(-91170.7001792607+91488.1598337297)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C41 equal 0.5*(${C4neg}+${C4pos})
variable C41 equal 0.5*(263.11383044592+${C4pos})
variable C41 equal 0.5*(263.11383044592+-263.13099698338)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C51 equal 0.5*(${C5neg}+${C5pos})
variable C51 equal 0.5*(-180.315179345676+${C5pos})
variable C51 equal 0.5*(-180.315179345676+180.297299970361)
