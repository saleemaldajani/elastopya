RELAXED_BOX 142.882248374039 142.877481684657 142.875799767784

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-391.414646707011)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-391.414646707011)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-430.051346526767)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-430.051346526767)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
