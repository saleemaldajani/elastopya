variable C25 equal 0.5*(21378.37809373+${C2pos})
variable C25 equal 0.5*(21378.37809373+-21378.3848904662)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(21624.5985886002+${C3pos})
variable C35 equal 0.5*(21624.5985886002+-21624.6078902311)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(-14.3855976727879+${C4pos})
variable C45 equal 0.5*(-14.3855976727879+14.3856635413871)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(119.899154820454+${C5pos})
variable C55 equal 0.5*(119.899154820454+96.5799902861753)
