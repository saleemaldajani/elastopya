variable C24 equal 0.5*(-66356.931965406+${C2pos})
variable C24 equal 0.5*(-66356.931965406+66356.910288655)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(-66272.6918931045+${C3pos})
variable C34 equal 0.5*(-66272.6918931045+66272.6643753255)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
