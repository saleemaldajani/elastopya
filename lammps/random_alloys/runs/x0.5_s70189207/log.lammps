variable C5pos equal ${d5}
variable C5pos equal -71.1725627542601
variable C6pos equal ${d6}
variable C6pos equal 360.774001897643

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(108443.269534685+${C1pos})
variable C15 equal 0.5*(108443.269534685+-108443.320059159)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(108147.911453976+${C2pos})
variable C25 equal 0.5*(108147.911453976+-108147.938101537)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(107730.687395493+${C3pos})
variable C35 equal 0.5*(107730.687395493+-107730.735733556)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
