# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -1013168.33891584
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 52.0533260830422
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 29.116579969838
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 2.73649382360582
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 124.306904455683
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -3.61354791605837
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 8.61992515785275
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -10.2944813372991

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 3492.67194258864
variable C2pos equal ${d2}
variable C2pos equal 4585.58817347317
variable C3pos equal ${d3}
variable C3pos equal 6501.9991032883
variable C4pos equal ${d4}
variable C4pos equal -22.8111518919301
variable C5pos equal ${d5}
variable C5pos equal 277.044232321185
variable C6pos equal ${d6}
variable C6pos equal 430.396005375811

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-3492.58728732238+${C1pos})
variable C15 equal 0.5*(-3492.58728732238+3492.67194258864)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-4585.56749421316+${C2pos})
variable C25 equal 0.5*(-4585.56749421316+4585.58817347317)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-6501.9140448216+${C3pos})
variable C35 equal 0.5*(-6501.9140448216+6501.9991032883)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(22.80564980615+${C4pos})
variable C45 equal 0.5*(22.80564980615+-22.8111518919301)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(-62.7746445225899+${C5pos})
variable C55 equal 0.5*(-62.7746445225899+277.044232321185)
