variable C4pos equal -22.8206971744601
variable C5pos equal ${d5}
variable C5pos equal 169.951956683791
variable C6pos equal ${d6}
variable C6pos equal 430.39585618918

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-3327.75238869751+${C1pos})
variable C13 equal 0.5*(-3327.75238869751+3657.50593341685)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-4420.67333053675+${C2pos})
variable C23 equal 0.5*(-4420.67333053675+4750.48185209072)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-6254.7036864079+${C3pos})
variable C33 equal 0.5*(-6254.7036864079+6749.2089884709)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
