variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -4.49447469356138
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 2.78132376677458

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 90900.0775893388
variable C2pos equal ${d2}
variable C2pos equal 91057.5218367195
variable C3pos equal ${d3}
variable C3pos equal 90893.3383053931
variable C4pos equal ${d4}
variable C4pos equal -143.36983627493
variable C5pos equal ${d5}
variable C5pos equal 296.118765795483
variable C6pos equal ${d6}
variable C6pos equal 132.370940157238

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-90900.0557164148+${C1pos})
variable C15 equal 0.5*(-90900.0557164148+90900.0775893388)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-91057.5098517312+${C2pos})
variable C25 equal 0.5*(-91057.5098517312+91057.5218367195)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-90893.3219062483+${C3pos})
variable C35 equal 0.5*(-90893.3219062483+90893.3383053931)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
