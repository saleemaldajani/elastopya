print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 143.209799983496 143.207555245509 143.204839196298

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--54.2011144933479)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--54.2011144933479)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--28.25967478732)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--28.25967478732)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--8.7757528055917)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--8.7757528055917)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
