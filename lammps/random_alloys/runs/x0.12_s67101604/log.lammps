variable C5pos equal 182.970643724799
variable C6pos equal ${d6}
variable C6pos equal 132.372574506362

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-90745.8747618729+${C1pos})
variable C13 equal 0.5*(-90745.8747618729+91054.2577430784)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
