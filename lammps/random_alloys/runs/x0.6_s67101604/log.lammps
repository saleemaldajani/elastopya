# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -1007798.4038826
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 1789.71213384955
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 1832.1046231869
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 1828.3733488723
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 1708.65842948945
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 0.827301784727716
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -3.63316281071134
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -11.0705600618192

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -170371.267273612
variable C2pos equal ${d2}
variable C2pos equal -169585.507750947
variable C3pos equal ${d3}
variable C3pos equal -170842.912882111
variable C4pos equal ${d4}
variable C4pos equal 71.9766823017101
variable C5pos equal ${d5}
variable C5pos equal 456.900475151033
variable C6pos equal ${d6}
variable C6pos equal 121.268492557518

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(170371.257583018+${C1pos})
variable C15 equal 0.5*(170371.257583018+-170371.267273612)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(169585.510159598+${C2pos})
variable C25 equal 0.5*(169585.510159598+-169585.507750947)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(170842.911823037+${C3pos})
variable C35 equal 0.5*(170842.911823037+-170842.912882111)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(-71.9774095216401+${C4pos})
variable C45 equal 0.5*(-71.9774095216401+71.9766823017101)
