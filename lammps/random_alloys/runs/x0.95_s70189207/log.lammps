variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 143.452845062494
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 143.45283306196
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 143.449199910187
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 143.452845062494 143.45283306196 143.449199910187

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--145.326080473937)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--145.326080473937)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--127.556219498912)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--127.556219498912)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--89.3546022655589)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--89.3546022655589)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
