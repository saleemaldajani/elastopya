# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -1030619.96747521
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -508.457096147335
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -508.194214807476
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -508.171648440911
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -509.005425193619
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -3.97527661478719
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 3.96816090583699
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -0.28847705916135

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 46227.6614249132
variable C2pos equal ${d2}
variable C2pos equal 46227.2811458844
variable C3pos equal ${d3}
variable C3pos equal 46311.9466142224
variable C4pos equal ${d4}
variable C4pos equal -157.690400617553
variable C5pos equal ${d5}
variable C5pos equal 2.31382880130502
variable C6pos equal ${d6}
variable C6pos equal -105.559081357968

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-45927.7090920385+${C1pos})
variable C13 equal 0.5*(-45927.7090920385+46227.6614249132)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-45927.323037787+${C2pos})
variable C23 equal 0.5*(-45927.323037787+46227.2811458844)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-45823.2260826683+${C3pos})
variable C33 equal 0.5*(-45823.2260826683+46311.9466142224)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(157.67681153556+${C4pos})
variable C43 equal 0.5*(157.67681153556+-157.690400617553)
