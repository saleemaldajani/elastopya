variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(-2.31462475689304+${C5pos})
variable C53 equal 0.5*(-2.31462475689304+2.31382880130502)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
