variable C5pos equal 159.36244177679
variable C6pos equal ${d6}
variable C6pos equal 152.655036206801

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-88824.8493556331+${C1pos})
variable C13 equal 0.5*(-88824.8493556331+89141.4451729604)
