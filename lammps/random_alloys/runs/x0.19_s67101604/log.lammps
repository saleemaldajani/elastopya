variable C5pos equal ${d5}
variable C5pos equal 270.52445890285
variable C6pos equal ${d6}
variable C6pos equal 152.644081462814

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-88983.13451584+${C1pos})
variable C15 equal 0.5*(-88983.13451584+88983.1608450345)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-88775.3928854022+${C2pos})
variable C25 equal 0.5*(-88775.3928854022+88775.4073861763)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-88220.4239634572+${C3pos})
variable C35 equal 0.5*(-88220.4239634572+88220.4506101609)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
