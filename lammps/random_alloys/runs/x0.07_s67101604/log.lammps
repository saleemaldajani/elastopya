RELAXED_BOX 143.005684786484 143.006486782211 143.007144936058

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-2.10479549729416)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-2.10479549729416)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-0.631389570047659)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-0.631389570047659)/(v_delta/v_len0)*0.0001
