# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -1030219.22552917
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -505.905973722315
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -503.291088106324
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -504.279587029767
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -510.147246030854
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -10.097685997777
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -6.91376208025119
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 7.7756295211278

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 50539.5883603618
variable C2pos equal ${d2}
variable C2pos equal 50491.0976599815
variable C3pos equal ${d3}
variable C3pos equal 50715.3733356708
variable C4pos equal ${d4}
variable C4pos equal -4.85487246628402
variable C5pos equal ${d5}
variable C5pos equal 182.080208017212
variable C6pos equal ${d6}
variable C6pos equal 66.2042552361641

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-50539.5886417799+${C1pos})
variable C15 equal 0.5*(-50539.5886417799+50539.5883603618)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-50491.0960373457+${C2pos})
variable C25 equal 0.5*(-50491.0960373457+50491.0976599815)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-50715.380228225+${C3pos})
variable C35 equal 0.5*(-50715.380228225+50715.3733356708)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(4.85392698746203+${C4pos})
variable C45 equal 0.5*(4.85392698746203+-4.85487246628402)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(46.943860064296+${C5pos})
variable C55 equal 0.5*(46.943860064296+182.080208017212)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
