# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -1030219.2246073
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -507.726025453941
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -504.798610640369
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -505.787074465703
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -512.592391255749
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -10.0976905092098
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -5.76860706422992
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 7.7755706182275

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 50690.3406137663
variable C2pos equal ${d2}
variable C2pos equal 50641.8464035751
variable C3pos equal ${d3}
variable C3pos equal 50959.8878581603
variable C4pos equal ${d4}
variable C4pos equal -4.84898217625407
variable C5pos equal ${d5}
variable C5pos equal 67.5647064150851
variable C6pos equal ${d6}
variable C6pos equal 66.2047063794439

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-50388.8356011173+${C1pos})
variable C13 equal 0.5*(-50388.8356011173+50690.3406137663)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-50340.3468046314+${C2pos})
variable C23 equal 0.5*(-50340.3468046314+50641.8464035751)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-50470.8661500991+${C3pos})
variable C33 equal 0.5*(-50470.8661500991+50959.8878581603)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(4.859817839729+${C4pos})
variable C43 equal 0.5*(4.859817839729+-4.84898217625407)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(-67.571641297722+${C5pos})
variable C53 equal 0.5*(-67.571641297722+67.5647064150851)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
