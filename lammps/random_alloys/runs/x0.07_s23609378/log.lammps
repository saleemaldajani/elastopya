RELAXED_BOX 143.016671689271 143.018034602432 143.03709043466

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--553.460741150193)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--553.460741150193)/(v_delta/v_len0)*0.0001
