variable C5pos equal ${d5}
variable C5pos equal -132.597241558324
variable C6pos equal ${d6}
variable C6pos equal 23.280078283761

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-69848.9916452615+${C1pos})
variable C13 equal 0.5*(-69848.9916452615+70156.1395110225)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-70349.7042288593+${C2pos})
variable C23 equal 0.5*(-70349.7042288593+70656.8787442025)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-69718.270943008+${C3pos})
variable C33 equal 0.5*(-69718.270943008+70208.3126116612)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
