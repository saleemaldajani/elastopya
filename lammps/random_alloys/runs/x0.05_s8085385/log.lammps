variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 142.9309143515
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 142.945581142653
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 142.924761551275 142.9309143515 142.945581142653

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--245.86183830714)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--245.86183830714)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--282.488156638774)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--282.488156638774)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--384.737301376289)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--384.737301376289)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
