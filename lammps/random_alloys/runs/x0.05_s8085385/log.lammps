# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -1030943.22301613
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -624.650728699056
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -566.559237075317
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -602.220662522901
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -705.172286498949
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 1.58624600218758
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 8.2629436052475
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -1.75462970013656

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 32069.7398768177
variable C2pos equal ${d2}
variable C2pos equal 31973.2505884127
variable C3pos equal ${d3}
variable C3pos equal 32043.498512266
variable C4pos equal ${d4}
variable C4pos equal -69.227751686714
variable C5pos equal ${d5}
variable C5pos equal -35.795007469928
variable C6pos equal ${d6}
variable C6pos equal -56.675923264016

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-31771.4828613554+${C1pos})
variable C13 equal 0.5*(-31771.4828613554+32069.7398768177)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-31675.0000851073+${C2pos})
variable C23 equal 0.5*(-31675.0000851073+31973.2505884127)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-31554.915972915+${C3pos})
variable C33 equal 0.5*(-31554.915972915+32043.498512266)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(69.221438034546+${C4pos})
variable C43 equal 0.5*(69.221438034546+-69.227751686714)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(35.795798866608+${C5pos})
variable C53 equal 0.5*(35.795798866608+-35.795007469928)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
