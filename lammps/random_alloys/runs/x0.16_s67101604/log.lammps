variable C5pos equal ${d5}
variable C5pos equal 307.880162614009
variable C6pos equal ${d6}
variable C6pos equal 55.7349432523011

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-79890.32205731+${C1pos})
variable C15 equal 0.5*(-79890.32205731+79890.3520366444)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-79958.7922946094+${C2pos})
variable C25 equal 0.5*(-79958.7922946094+79958.8102947757)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
