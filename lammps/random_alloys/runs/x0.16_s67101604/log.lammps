RELAXED_BOX 143.349603608608 143.348740670275 143.349977913066

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--0.151971300663933)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--0.151971300663933)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-5.79598743420935)/(v_delta/v_len0)*${cfac}
