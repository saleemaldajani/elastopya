RELAXED_BOX 71.8587835456626 71.8600872210458 71.8698967779506

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--87.3886377403497)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--87.3886377403497)/(v_delta/v_len0)*0.0001
