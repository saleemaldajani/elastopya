variable pxz1 equal -71.8368471626445
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -62.6318391697158

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 24825.8847520835
variable C2neg equal ${d2}
variable C2neg equal 23296.7013128167
variable C3neg equal ${d3}
variable C3neg equal 23230.7259279159
