print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7484043356797 71.7468443945567 71.7472756021263

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-4.76942443534956)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-4.76942443534956)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-0.538024012084539)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-0.538024012084539)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--6.11230707473788)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--6.11230707473788)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
