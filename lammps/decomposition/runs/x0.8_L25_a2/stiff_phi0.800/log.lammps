variable C31 equal 0.5*(103961.399292143+-103624.977666768)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C41 equal 0.5*(${C4neg}+${C4pos})
variable C41 equal 0.5*(405.4011274095+${C4pos})
variable C41 equal 0.5*(405.4011274095+-405.37338451983)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C51 equal 0.5*(${C5neg}+${C5pos})
variable C51 equal 0.5*(12.3657952438499+${C5pos})
variable C51 equal 0.5*(12.3657952438499+-12.3820844082204)
