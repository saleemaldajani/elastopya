variable C5pos equal ${d5}
variable C5pos equal -180.76298964296
variable C6pos equal ${d6}
variable C6pos equal 1178.26993974313

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(153957.13177931+${C1pos})
variable C15 equal 0.5*(153957.13177931+-153957.169477776)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(153932.837726561+${C2pos})
variable C25 equal 0.5*(153932.837726561+-153932.833961386)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(156364.824330585+${C3pos})
variable C35 equal 0.5*(156364.824330585+-156364.865666729)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
