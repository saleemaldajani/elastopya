variable pyz1 equal 35.7656451925351

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -59671.7597628748
variable C2neg equal ${d2}
variable C2neg equal -57898.7120313604
variable C3neg equal ${d3}
variable C3neg equal -56408.6421268737
