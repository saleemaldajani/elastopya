variable shearmodulus1 equal ${C44cubic}
variable shearmodulus1 equal 105.497998348294
variable shearmodulus2 equal (${C11cubic}-${C12cubic})/2.0
variable shearmodulus2 equal (260.293245385833-${C12cubic})/2.0
variable shearmodulus2 equal (260.293245385833-169.898089061331)/2.0
variable poissonratio equal 1.0/(1.0+${C11cubic}/${C12cubic})
variable poissonratio equal 1.0/(1.0+260.293245385833/${C12cubic})
variable poissonratio equal 1.0/(1.0+260.293245385833/169.898089061331)

