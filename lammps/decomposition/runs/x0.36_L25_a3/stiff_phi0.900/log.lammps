variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(446.247523452358+${C4pos})
variable C44 equal 0.5*(446.247523452358+-225.585478625428)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(-373.368628291149+${C5pos})
variable C54 equal 0.5*(-373.368628291149+373.38125032467)
