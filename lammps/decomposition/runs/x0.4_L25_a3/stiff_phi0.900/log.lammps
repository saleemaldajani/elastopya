variable pxy1 equal -31.7074349740378
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -4.98188914586144
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 32.1758062035784

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 34694.8196888202
variable C2pos equal ${d2}
variable C2pos equal 30631.9889371813
variable C3pos equal ${d3}
variable C3pos equal 35285.3821376311
