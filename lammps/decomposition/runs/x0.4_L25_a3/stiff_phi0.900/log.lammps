variable d2 equal -(v_pyy1--155.379360073734)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--169.646478264849)/(v_delta/v_len0)*${cfac}
