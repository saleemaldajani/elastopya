variable C5pos equal ${d5}
variable C5pos equal -602.436093313306
variable C6pos equal ${d6}
variable C6pos equal 173.06214623724

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-34373.131681748+${C1pos})
variable C13 equal 0.5*(-34373.131681748+34694.8196888202)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-30310.3024816302+${C2pos})
variable C23 equal 0.5*(-30310.3024816302+30631.9889371813)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-34772.596459535+${C3pos})
variable C33 equal 0.5*(-34772.596459535+35285.3821376311)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
