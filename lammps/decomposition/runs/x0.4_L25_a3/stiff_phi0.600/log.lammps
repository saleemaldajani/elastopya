print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.9539367249517 71.9503679831231 71.9209864781409

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-142.974437033863)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-142.974437033863)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-157.347803251163)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-157.347803251163)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
