variable C5pos equal ${d5}
variable C5pos equal -749.13363884514
variable C6pos equal ${d6}
variable C6pos equal -763.563432551679

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(21554.4587920716+${C1pos})
variable C15 equal 0.5*(21554.4587920716+-21554.4085522316)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(23431.8064005301+${C2pos})
variable C25 equal 0.5*(23431.8064005301+-23431.8571950339)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(21872.6297200349+${C3pos})
variable C35 equal 0.5*(21872.6297200349+-21872.5696118163)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
