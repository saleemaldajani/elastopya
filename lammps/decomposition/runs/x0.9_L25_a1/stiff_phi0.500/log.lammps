variable C5pos equal ${d5}
variable C5pos equal 190.258126433798
variable C6pos equal ${d6}
variable C6pos equal 23.83013236323

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(109357.459425687+${C1pos})
variable C13 equal 0.5*(109357.459425687+-109021.093321526)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(106482.037542352+${C2pos})
variable C23 equal 0.5*(106482.037542352+-106145.763548713)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(106526.632368378+${C3pos})
variable C33 equal 0.5*(106526.632368378+-105923.267570373)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
