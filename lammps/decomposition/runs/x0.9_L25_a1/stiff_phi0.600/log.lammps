print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7808947192233 71.7965854486375 71.785434006658

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--182.507156159014)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--182.507156159014)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--426.960035908121)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--426.960035908121)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--282.494824649097)/(v_delta/v_len0)*${cfac}
