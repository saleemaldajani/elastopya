variable pxx1 equal -620.928376107656
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -595.382727675826
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -612.932901695833
