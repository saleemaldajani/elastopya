print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7468554742343 71.7509680976497 71.7533148819386

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--2.19355291479051)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--2.19355291479051)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-13.1811494852315)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-13.1811494852315)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-32.7281125307933)/(v_delta/v_len0)*${cfac}
