# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128026.628771163
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -508.885668761545
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -454.906410251946
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -486.323777741792
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -585.426818290897
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -115.411947334107
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -50.4661206456128
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 18.0005544220097

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 65992.1245018971
variable C2pos equal ${d2}
variable C2pos equal 65565.653934664
variable C3pos equal ${d3}
variable C3pos equal 66583.7706029429
variable C4pos equal ${d4}
variable C4pos equal 680.88745746422
variable C5pos equal ${d5}
variable C5pos equal 71.8312110081698
variable C6pos equal ${d6}
variable C6pos equal -98.9895533123999

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-65676.5713085538+${C1pos})
variable C13 equal 0.5*(-65676.5713085538+65992.1245018971)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-65250.1233146565+${C2pos})
variable C23 equal 0.5*(-65250.1233146565+65565.653934664)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-66080.5681616363+${C3pos})
variable C33 equal 0.5*(-66080.5681616363+66583.7706029429)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(-680.85146498097+${C4pos})
variable C43 equal 0.5*(-680.85146498097+680.88745746422)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(-71.7712606591199+${C5pos})
variable C53 equal 0.5*(-71.7712606591199+71.8312110081698)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
