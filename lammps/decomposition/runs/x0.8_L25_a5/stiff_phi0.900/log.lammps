variable C4pos equal 229.41565731475
variable C5pos equal ${d5}
variable C5pos equal 136.16270766764
variable C6pos equal ${d6}
variable C6pos equal -146.11760606176

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C11 equal 0.5*(${C1neg}+${C1pos})
variable C11 equal 0.5*(35704.5441604582+${C1pos})
variable C11 equal 0.5*(35704.5441604582+-35123.4217077008)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C21 equal 0.5*(${C2neg}+${C2pos})
variable C21 equal 0.5*(39766.5002749839+${C2pos})
variable C21 equal 0.5*(39766.5002749839+-39434.040665351)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C31 equal 0.5*(${C3neg}+${C3pos})
variable C31 equal 0.5*(36478.5037140739+${C3pos})
variable C31 equal 0.5*(36478.5037140739+-36145.9059151782)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
