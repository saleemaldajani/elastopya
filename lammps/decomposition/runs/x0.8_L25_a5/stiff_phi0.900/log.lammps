variable d2 equal -(v_pyy1--92.520695982603)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-74.5519614679567)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-74.5519614679567)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
