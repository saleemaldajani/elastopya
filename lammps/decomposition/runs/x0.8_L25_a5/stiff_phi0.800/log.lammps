variable C25 equal 0.5*(91083.7703950096+-91083.8399148334)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(89099.9986777087+${C3pos})
variable C35 equal 0.5*(89099.9986777087+-89099.9998007802)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(265.427721767882+${C4pos})
variable C45 equal 0.5*(265.427721767882+-265.387190649783)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(481.71093894504+${C5pos})
variable C55 equal 0.5*(481.71093894504+-266.61348656396)
