# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -126611.12230778
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 1648.95806708125
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 1640.68300277982
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 1778.95521413322
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 1527.23598433069
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -22.914372035413
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 26.6057933185703
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -44.5771494654619

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -173967.359017739
variable C2pos equal ${d2}
variable C2pos equal -179612.078339026
variable C3pos equal ${d3}
variable C3pos equal -178481.735608835
variable C4pos equal ${d4}
variable C4pos equal -160.85439276293
variable C5pos equal ${d5}
variable C5pos equal 94.1488094719801
variable C6pos equal ${d6}
variable C6pos equal 223.80921431211

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(173967.506298771+${C1pos})
variable C15 equal 0.5*(173967.506298771+-173967.359017739)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(179612.149488253+${C2pos})
variable C25 equal 0.5*(179612.149488253+-179612.078339026)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(178481.883008679+${C3pos})
variable C35 equal 0.5*(178481.883008679+-178481.735608835)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(160.84879733002+${C4pos})
variable C45 equal 0.5*(160.84879733002+-160.85439276293)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(120.08235264027+${C5pos})
variable C55 equal 0.5*(120.08235264027+94.1488094719801)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
