variable C4pos equal 71.0459954577059
variable C5pos equal ${d5}
variable C5pos equal 515.28869260871
variable C6pos equal ${d6}
variable C6pos equal 670.80183069216

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(147555.720798381+${C1pos})
variable C13 equal 0.5*(147555.720798381+-147216.837973257)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(148685.143546761+${C2pos})
variable C23 equal 0.5*(148685.143546761+-148346.313657182)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(151410.809644802+${C3pos})
variable C33 equal 0.5*(151410.809644802+-150839.230887389)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(-71.068719242936+${C4pos})
variable C43 equal 0.5*(-71.068719242936+71.0459954577059)
