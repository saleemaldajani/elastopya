variable C6pos equal ${d6}
variable C6pos equal 286.967597599142

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(99429.1329136971+${C1pos})
variable C13 equal 0.5*(99429.1329136971+-99093.5051593931)
