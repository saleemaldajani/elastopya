print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7462052733482 71.7453181192078 71.7457118155767

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-16.3976041462462)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-16.3976041462462)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--56.6236255986512)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--56.6236255986512)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--15.7536383794577)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--15.7536383794577)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
