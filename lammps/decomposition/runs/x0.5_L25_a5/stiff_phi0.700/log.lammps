variable C5pos equal ${d5}
variable C5pos equal -208.14842290983
variable C6pos equal ${d6}
variable C6pos equal -9.64462956941006

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(69528.9235594271+${C1pos})
variable C13 equal 0.5*(69528.9235594271+-69195.1009356053)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(78781.1065882977+${C2pos})
variable C23 equal 0.5*(78781.1065882977+-78447.0819569908)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(75518.6018280033+${C3pos})
variable C33 equal 0.5*(75518.6018280033+-75008.0110511805)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
