variable C4pos equal 217.353329035
variable C5pos equal ${d5}
variable C5pos equal 14.7419702099597
variable C6pos equal ${d6}
variable C6pos equal -741.67520293684

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-75364.8943563254+${C1pos})
variable C15 equal 0.5*(-75364.8943563254+75364.8874414587)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-77978.4755601837+${C2pos})
variable C25 equal 0.5*(-77978.4755601837+77978.4963318852)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-75434.5151285787+${C3pos})
variable C35 equal 0.5*(-75434.5151285787+75434.4862639562)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
