# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128335.615656495
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -610.075714657278
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -616.682484691754
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -592.917890939284
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -620.626768340797
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 32.3848056805877
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -31.6752438237667
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -18.9866303598206

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 75519.3431871439
variable C2pos equal ${d2}
variable C2pos equal 78132.9275418311
variable C3pos equal ${d3}
variable C3pos equal 75682.6617332138
variable C4pos equal ${d4}
variable C4pos equal 217.38311730608
variable C5pos equal ${d5}
variable C5pos equal -97.8584476854202
variable C6pos equal ${d6}
variable C6pos equal -741.671294546529

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-75210.4377979527+${C1pos})
variable C13 equal 0.5*(-75210.4377979527+75519.3431871439)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-77824.0438896983+${C2pos})
variable C23 equal 0.5*(-77824.0438896983+78132.9275418311)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-75186.3398313672+${C3pos})
variable C33 equal 0.5*(-75186.3398313672+75682.6617332138)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(-217.36360026168+${C4pos})
variable C43 equal 0.5*(-217.36360026168+217.38311730608)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(97.8295828056901+${C5pos})
variable C53 equal 0.5*(97.8295828056901+-97.8584476854202)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
