variable C5pos equal ${d5}
variable C5pos equal -107.68691933495
variable C6pos equal ${d6}
variable C6pos equal 448.953505849843

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-90123.6411224713+${C1pos})
variable C13 equal 0.5*(-90123.6411224713+90436.0264860048)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-90334.9037743129+${C2pos})
variable C23 equal 0.5*(-90334.9037743129+90647.2250181415)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-91501.4940053756+${C3pos})
variable C33 equal 0.5*(-91501.4940053756+91995.3389141648)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
