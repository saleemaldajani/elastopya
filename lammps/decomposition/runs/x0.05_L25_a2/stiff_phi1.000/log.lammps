# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128778.037585848
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -95.8135816825269
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -48.5820281043256
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -37.0506664427571
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -201.808050500498
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 21.5102116836395
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 15.2542395404676
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 32.2099285412027

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 7142.14231795548
variable C2pos equal ${d2}
variable C2pos equal 6871.96073231351
variable C3pos equal ${d3}
variable C3pos equal 7085.7139967002
variable C4pos equal ${d4}
variable C4pos equal -51.51934868091
variable C5pos equal ${d5}
variable C5pos equal 151.78828550632
variable C6pos equal ${d6}
variable C6pos equal -81.5194436714901

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-7142.13571643054+${C1pos})
variable C15 equal 0.5*(-7142.13571643054+7142.14231795548)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-6871.96639920861+${C2pos})
variable C25 equal 0.5*(-6871.96639920861+6871.96073231351)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-7085.6992394279+${C3pos})
variable C35 equal 0.5*(-7085.6992394279+7085.7139967002)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(51.5006300529901+${C4pos})
variable C45 equal 0.5*(51.5006300529901+-51.51934868091)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(78.79581338+${C5pos})
variable C55 equal 0.5*(78.79581338+151.78828550632)
