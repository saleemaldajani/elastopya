# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128039.040854546
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -140.434438094521
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 12.1016549345616
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -147.319128858341
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -286.085840359785
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 2.74019613404993
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -4.30418165143914
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -18.7409744369952

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -2789.43440917349
variable C2pos equal ${d2}
variable C2pos equal -1956.9698604748
variable C3pos equal ${d3}
variable C3pos equal -2063.9045664708
variable C4pos equal ${d4}
variable C4pos equal -82.8934425287301
variable C5pos equal ${d5}
variable C5pos equal -24.767253640569
variable C6pos equal ${d6}
variable C6pos equal -41.763187311069

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(3118.18854575343+${C1pos})
variable C13 equal 0.5*(3118.18854575343+-2789.43440917349)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(2285.6632879683+${C2pos})
variable C23 equal 0.5*(2285.6632879683+-1956.9698604748)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(2673.0901582007+${C3pos})
variable C33 equal 0.5*(2673.0901582007+-2063.9045664708)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(82.8551273768799+${C4pos})
variable C43 equal 0.5*(82.8551273768799+-82.8934425287301)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(24.741823561265+${C5pos})
variable C53 equal 0.5*(24.741823561265+-24.767253640569)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
