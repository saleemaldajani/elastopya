variable C5pos equal ${d5}
variable C5pos equal -149.54568109997
variable C6pos equal ${d6}
variable C6pos equal 132.52430787827

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(30331.0402440626+${C1pos})
variable C13 equal 0.5*(30331.0402440626+-29997.44754317)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(27154.2642505431+${C2pos})
variable C23 equal 0.5*(27154.2642505431+-26820.6482180186)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(29422.5186279006+${C3pos})
variable C33 equal 0.5*(29422.5186279006+-28818.3138288951)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
