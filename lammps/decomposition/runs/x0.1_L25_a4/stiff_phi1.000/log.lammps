RELAXED_BOX 71.4472742344757 71.4482304145778 71.4475052809868

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--344.599755070381)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--344.599755070381)/(v_delta/v_len0)*0.0001
