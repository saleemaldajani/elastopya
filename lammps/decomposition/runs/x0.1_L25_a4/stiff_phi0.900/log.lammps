variable C5pos equal ${d5}
variable C5pos equal -265.49164461167
variable C6pos equal ${d6}
variable C6pos equal -345.013898112366

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-49917.1898251879+${C1pos})
variable C15 equal 0.5*(-49917.1898251879+49917.1810823203)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-48357.4514171059+${C2pos})
variable C25 equal 0.5*(-48357.4514171059+48357.4000934725)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-49131.20329748+${C3pos})
variable C35 equal 0.5*(-49131.20329748+49131.2067801143)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
