variable pxy1 equal -20.2331232114126
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 16.4624259559583
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 36.8000258145772

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 60387.6338693022
variable C2pos equal ${d2}
variable C2pos equal 62632.3092443756
variable C3pos equal ${d3}
variable C3pos equal 61741.0077979761
