# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128564.285108941
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -980.930088521541
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -986.61369445639
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -979.997399680045
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -976.179171428188
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 14.032942715245
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -5.63197941540697
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 8.21084226919061

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 95742.2584229132
variable C2pos equal ${d2}
variable C2pos equal 94240.2209318978
variable C3pos equal ${d3}
variable C3pos equal 96367.828310273
variable C4pos equal ${d4}
variable C4pos equal 452.082688261069
variable C5pos equal ${d5}
variable C5pos equal 280.560279600658
variable C6pos equal ${d6}
variable C6pos equal -642.285909378541

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(-95742.2277342056+${C1pos})
variable C14 equal 0.5*(-95742.2277342056+95742.2584229132)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(-94240.1937846902+${C2pos})
variable C24 equal 0.5*(-94240.1937846902+94240.2209318978)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(-96367.799926853+${C3pos})
variable C34 equal 0.5*(-96367.799926853+96367.828310273)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(-224.83918894055+${C4pos})
variable C44 equal 0.5*(-224.83918894055+452.082688261069)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(-280.564090759636+${C5pos})
variable C54 equal 0.5*(-280.564090759636+280.560279600658)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
