print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.5679270194691 71.565123024176 71.5708144614123

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--29.1911102272582)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--29.1911102272582)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--37.5951903610671)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--37.5951903610671)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--12.5008883254578)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--12.5008883254578)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
