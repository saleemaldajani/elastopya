# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -126834.02982224
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 882.094897822332
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 956.819914409142
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 846.042580559811
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 843.422198498042
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -36.7932935637205
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 3.87289020306219
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -19.0554462688325

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -113510.76235621
variable C2pos equal ${d2}
variable C2pos equal -114321.280541536
variable C3pos equal ${d3}
variable C3pos equal -112541.302754363
variable C4pos equal ${d4}
variable C4pos equal -86.4975605403199
variable C5pos equal ${d5}
variable C5pos equal 110.401500931071
variable C6pos equal ${d6}
variable C6pos equal -10.3790601150699

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(113846.947958982+${C1pos})
variable C13 equal 0.5*(113846.947958982+-113510.76235621)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(114657.796405133+${C2pos})
variable C23 equal 0.5*(114657.796405133+-114321.280541536)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(113093.699221066+${C3pos})
variable C33 equal 0.5*(113093.699221066+-112541.302754363)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(86.37466458045+${C4pos})
variable C43 equal 0.5*(86.37466458045+-86.4975605403199)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(-110.444370755551+${C5pos})
variable C53 equal 0.5*(-110.444370755551+110.401500931071)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
