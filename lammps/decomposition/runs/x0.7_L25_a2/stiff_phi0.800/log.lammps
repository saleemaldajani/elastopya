RELAXED_BOX 71.8486710666069 71.8638177460664 71.8616208521688

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--178.287709152956)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--178.287709152956)/(v_delta/v_len0)*0.0001
