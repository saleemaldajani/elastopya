variable C4pos equal 306.239324561931
variable C5pos equal ${d5}
variable C5pos equal 101.62790270865
variable C6pos equal ${d6}
variable C6pos equal 197.44227921995

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-6718.63594180323+${C1pos})
variable C13 equal 0.5*(-6718.63594180323+7044.13361123982)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-10933.4541310625+${C2pos})
variable C23 equal 0.5*(-10933.4541310625+11259.0144171351)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-12688.3960021437+${C3pos})
variable C33 equal 0.5*(-12688.3960021437+13254.4879241693)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
