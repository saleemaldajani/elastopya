RELAXED_BOX 71.64974306367 71.6501949579443 71.6486274583858

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--14.650740738694)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--14.650740738694)/(v_delta/v_len0)*0.0001
