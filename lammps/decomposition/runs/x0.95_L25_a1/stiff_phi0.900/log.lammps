# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -127941.771633744
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 411.571141349261
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 494.341469391475
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 391.52967690356
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 348.842277752749
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 13.2235992891083
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -12.5365063249882
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -15.4343495037848

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -11199.9875202906
variable C2pos equal ${d2}
variable C2pos equal -10704.9448840909
variable C3pos equal ${d3}
variable C3pos equal -10863.9061859922
variable C4pos equal ${d4}
variable C4pos equal 23.0319821487401
variable C5pos equal ${d5}
variable C5pos equal -43.44375433636
variable C6pos equal ${d6}
variable C6pos equal -34.05464315441

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(11199.992259252+${C1pos})
variable C14 equal 0.5*(11199.992259252+-11199.9875202906)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(10704.9094663395+${C2pos})
variable C24 equal 0.5*(10704.9094663395+-10704.9448840909)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(10863.8670456593+${C3pos})
variable C34 equal 0.5*(10863.8670456593+-10863.9061859922)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(193.42916265717+${C4pos})
variable C44 equal 0.5*(193.42916265717+23.0319821487401)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(43.43094658461+${C5pos})
variable C54 equal 0.5*(43.43094658461+-43.44375433636)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
