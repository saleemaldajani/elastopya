variable pxz1 equal -12.5364398370538
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -14.3522495732996

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 11365.1732251208
variable C2neg equal ${d2}
variable C2neg equal 11016.3431216361
variable C3neg equal ${d3}
variable C3neg equal 11029.0435478599
