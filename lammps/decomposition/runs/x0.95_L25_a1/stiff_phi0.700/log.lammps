RELAXED_BOX 71.7088313271425 71.7114282672724 71.7114463418514

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-474.958387685325)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-474.958387685325)/(v_delta/v_len0)*0.0001
