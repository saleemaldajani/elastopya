RELAXED_BOX 71.9412467997492 71.9574042726019 71.9494681531301

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--249.60428391371)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--249.60428391371)/(v_delta/v_len0)*0.0001
