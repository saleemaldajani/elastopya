variable C23 equal 0.5*(165633.544796855+${C2pos})
variable C23 equal 0.5*(165633.544796855+-165294.420299126)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
