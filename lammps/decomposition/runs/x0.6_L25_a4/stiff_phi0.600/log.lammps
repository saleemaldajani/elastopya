RELAXED_BOX 71.9936488796835 71.9756517632266 71.9944032351688

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--99.9458663982711)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--99.9458663982711)/(v_delta/v_len0)*0.0001
