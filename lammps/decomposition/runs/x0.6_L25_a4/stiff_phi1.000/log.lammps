RELAXED_BOX 71.6478975952044 71.6316344690864 71.6308672545359

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--367.537851794369)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--367.537851794369)/(v_delta/v_len0)*0.0001
