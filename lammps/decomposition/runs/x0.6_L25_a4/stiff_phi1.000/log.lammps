variable C4pos equal 28.0794875134802
variable C5pos equal ${d5}
variable C5pos equal -55.1894007417097
variable C6pos equal ${d6}
variable C6pos equal -0.821886833060148

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-18858.9855496025+${C1pos})
variable C13 equal 0.5*(-18858.9855496025+19182.0307718314)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-24512.717998788+${C2pos})
variable C23 equal 0.5*(-24512.717998788+24835.2872915443)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-24593.0254874936+${C3pos})
variable C33 equal 0.5*(-24593.0254874936+25138.8149114605)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
