# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -125992.019319158
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 1688.4706422348
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 1722.52151694947
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 1701.47728487178
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 1641.41312488317
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 12.2893945267373
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 25.6509592481907
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -0.98561885715407

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -182825.139956964
variable C2pos equal ${d2}
variable C2pos equal -180969.676074363
variable C3pos equal ${d3}
variable C3pos equal -175606.379008611
variable C4pos equal ${d4}
variable C4pos equal 509.327300319521
variable C5pos equal ${d5}
variable C5pos equal 1831.33222947801
variable C6pos equal ${d6}
variable C6pos equal -419.753951933036

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(182825.18172179+${C1pos})
variable C15 equal 0.5*(182825.18172179+-182825.139956964)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(180969.630641048+${C2pos})
variable C25 equal 0.5*(180969.630641048+-180969.676074363)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(175606.465428095+${C3pos})
variable C35 equal 0.5*(175606.465428095+-175606.379008611)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(-509.285155828906+${C4pos})
variable C45 equal 0.5*(-509.285155828906+509.327300319521)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(-1620.50935985346+${C5pos})
variable C55 equal 0.5*(-1620.50935985346+1831.33222947801)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
