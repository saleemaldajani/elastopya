variable C5pos equal ${d5}
variable C5pos equal -281.40507028187
variable C6pos equal ${d6}
variable C6pos equal 31.2108440059109

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(160787.865907628+${C1pos})
variable C13 equal 0.5*(160787.865907628+-160448.658002315)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(161892.549361045+${C2pos})
variable C23 equal 0.5*(161892.549361045+-161553.340243618)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(162436.127759195+${C3pos})
variable C33 equal 0.5*(162436.127759195+-161890.523485533)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
