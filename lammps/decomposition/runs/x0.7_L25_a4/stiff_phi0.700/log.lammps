variable C6pos equal ${d6}
variable C6pos equal 31.220072409209

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(160618.23959342+${C1pos})
variable C14 equal 0.5*(160618.23959342+-160618.283761379)
