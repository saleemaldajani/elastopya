RELAXED_BOX 71.9188340015437 71.9171375626537 71.9168138399874

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--149.573553123322)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--149.573553123322)/(v_delta/v_len0)*0.0001
