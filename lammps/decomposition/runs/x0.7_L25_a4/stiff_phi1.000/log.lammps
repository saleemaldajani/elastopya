# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128007.607997705
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 22.42013665578
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -8.66979358828847
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 101.5984410679
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -25.6682375122714
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 125.29960917977
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 42.1103740167022
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -43.5166640168132

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 3564.38326353066
variable C2pos equal ${d2}
variable C2pos equal 8644.1624240205
variable C3pos equal ${d3}
variable C3pos equal 5951.74954622231
variable C4pos equal ${d4}
variable C4pos equal -31.7085264959296
variable C5pos equal ${d5}
variable C5pos equal 135.819540524709
variable C6pos equal ${d6}
variable C6pos equal 227.5970358717

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-3564.33386624939+${C1pos})
variable C15 equal 0.5*(-3564.33386624939+3564.38326353066)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-8644.2561289576+${C2pos})
variable C25 equal 0.5*(-8644.2561289576+8644.1624240205)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-5951.68456422411+${C3pos})
variable C35 equal 0.5*(-5951.68456422411+5951.74954622231)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(31.6264912079795+${C4pos})
variable C45 equal 0.5*(31.6264912079795+-31.7085264959296)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(81.9682311163206+${C5pos})
variable C55 equal 0.5*(81.9682311163206+135.819540524709)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
