# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128342.018570231
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -800.551850216315
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -758.193924384174
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -887.302429387347
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -756.159196877423
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -45.9885429047477
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -20.0277863204324
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -11.3075783824845

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 78541.1970391577
variable C2pos equal ${d2}
variable C2pos equal 77360.3619706244
variable C3pos equal ${d3}
variable C3pos equal 76932.3943969156
variable C4pos equal ${d4}
variable C4pos equal -674.92994899284
variable C5pos equal ${d5}
variable C5pos equal 408.54063188881
variable C6pos equal ${d6}
variable C6pos equal 180.92055678765

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-78232.6435496675+${C1pos})
variable C13 equal 0.5*(-78232.6435496675+78541.1970391577)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-77051.743611146+${C2pos})
variable C23 equal 0.5*(-77051.743611146+77360.3619706244)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-76436.0284782467+${C3pos})
variable C33 equal 0.5*(-76436.0284782467+76932.3943969156)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(674.83948047854+${C4pos})
variable C43 equal 0.5*(674.83948047854+-674.92994899284)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(-408.54654099473+${C5pos})
variable C53 equal 0.5*(-408.54654099473+408.54063188881)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
