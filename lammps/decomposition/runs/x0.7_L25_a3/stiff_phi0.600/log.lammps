variable pxy1 equal -2.46038909117959
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 45.7908608514665
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -28.7425136438017

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -194496.375704554
variable C2pos equal ${d2}
variable C2pos equal -189260.877804766
variable C3pos equal ${d3}
variable C3pos equal -198195.851231855
