variable C21 equal 0.5*(24711.8245711888+-24378.3433143039)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C31 equal 0.5*(${C3neg}+${C3pos})
variable C31 equal 0.5*(24598.7197174682+${C3pos})
variable C31 equal 0.5*(24598.7197174682+-24265.3265125366)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C41 equal 0.5*(${C4neg}+${C4pos})
variable C41 equal 0.5*(101.79267151583+${C4pos})
variable C41 equal 0.5*(101.79267151583+-101.78529081272)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C51 equal 0.5*(${C5neg}+${C5pos})
variable C51 equal 0.5*(277.495339974599+${C5pos})
variable C51 equal 0.5*(277.495339974599+-277.548003926263)
