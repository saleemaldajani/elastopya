# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128862.526132004
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -351.953378334161
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -391.137839169262
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -358.431052824918
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -306.291243008302
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -4.172714209655
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -2.98406150195858
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -3.31185065005393

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 14130.4976123119
variable C2pos equal ${d2}
variable C2pos equal 14150.2224219129
variable C3pos equal ${d3}
variable C3pos equal 14219.2628923256
variable C4pos equal ${d4}
variable C4pos equal 231.840772833487
variable C5pos equal ${d5}
variable C5pos equal 100.055302767009
variable C6pos equal ${d6}
variable C6pos equal -49.846379855076

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(-14130.4740638886+${C1pos})
variable C14 equal 0.5*(-14130.4740638886+14130.4976123119)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(-14150.1761338672+${C2pos})
variable C24 equal 0.5*(-14150.1761338672+14150.2224219129)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(-14219.2189360729+${C3pos})
variable C34 equal 0.5*(-14219.2189360729+14219.2628923256)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(-1.85056505070389+${C4pos})
variable C44 equal 0.5*(-1.85056505070389+231.840772833487)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(-100.046964031271+${C5pos})
variable C54 equal 0.5*(-100.046964031271+100.055302767009)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
