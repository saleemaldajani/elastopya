# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128082.674444226
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 0.0578108423377172
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -1.07091315877925
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 0.428477433299246
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 0.815868252493156
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 18.7039204550878
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 19.7602551684921
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -21.4856150578962

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -156.486279146344
variable C2pos equal ${d2}
variable C2pos equal -23.2281414342913
variable C3pos equal ${d3}
variable C3pos equal 101.750019587152
variable C4pos equal ${d4}
variable C4pos equal -13.60438821259
variable C5pos equal ${d5}
variable C5pos equal 3.19148885700997
variable C6pos equal ${d6}
variable C6pos equal 8.62601862690013

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(485.328588551694+${C1pos})
variable C12 equal 0.5*(485.328588551694+-156.486279146344)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(646.903041027982+${C2pos})
variable C22 equal 0.5*(646.903041027982+-23.2281414342913)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(226.957753763242+${C3pos})
variable C32 equal 0.5*(226.957753763242+101.750019587152)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C42 equal 0.5*(${C4neg}+${C4pos})
variable C42 equal 0.5*(13.5991789956002+${C4pos})
variable C42 equal 0.5*(13.5991789956002+-13.60438821259)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C52 equal 0.5*(${C5neg}+${C5pos})
variable C52 equal 0.5*(-3.1880176814802+${C5pos})
variable C52 equal 0.5*(-3.1880176814802+3.19148885700997)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
variable C62 equal 0.5*(${C6neg}+${C6pos})
variable C62 equal 0.5*(-8.62979799572017+${C6pos})
variable C62 equal 0.5*(-8.62979799572017+8.62601862690013)

# Delete dir to make sure it is not reused

variable dir delete

# uzz Perturbation

variable dir equal 3
include displace.mod
# NOTE: This script should not need to be
# modified. See in.elastic for more info.
#
# Find which reference length to use

if "${dir} == 1" then    "variable len0 equal ${lx0}"
if "${dir} == 2" then    "variable len0 equal ${ly0}"
if "${dir} == 3" then    "variable len0 equal ${lz0}"
variable len0 equal ${lz0}
variable len0 equal 71.6581650300664
if "${dir} == 4" then    "variable len0 equal ${lz0}"
if "${dir} == 5" then    "variable len0 equal ${lz0}"
if "${dir} == 6" then    "variable len0 equal ${ly0}"

# Reset box and simulation parameters

clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
box tilt large

The 'box' command has been removed and will be ignored

read_restart restart.equil
Reading restart file ...
  restart file = 22 Jul 2025, LAMMPS = 22 Jul 2025
  restoring atom style atomic from restart
  triclinic box = (-0.0048245434 -0.0044523398 -0.004082515) to (71.654825 71.654452 71.654083) with tilt (0 0 0)
  4 by 2 by 2 MPI processor grid
  pair style hybrid/overlay stores no restart info
  31250 atoms
  read_restart CPU = 0.005 seconds
include potential.mod
# NOTE: This script can be modified for different pair styles
# See in.elastic for more info.

# Choose potential
pair_style hybrid/overlay eam/alloy eam/fs
pair_coeff * * eam/alloy FeCr_d.eam.alloy.txt Fe Cr
pair_coeff * * eam/fs FeCr_s.eam.fs.txt Fe Cr

# Setup neighbor style
neighbor 1.0 nsq
neigh_modify once no every 1 delay 0 check yes

# Setup minimization style
min_style	     cg
min_modify	     dmax ${dmax} line quadratic
min_modify	     dmax 0.01 line quadratic

# Setup output
thermo		1
thermo_style custom step temp pe press pxx pyy pzz pxy pxz pyz lx ly lz vol
thermo_modify norm no

# Negative deformation

variable delta equal -${up}*${len0}
variable delta equal -1e-06*${len0}
variable delta equal -1e-06*71.6581650300664
variable deltaxy equal -${up}*xy
variable deltaxy equal -1e-06*xy
variable deltaxz equal -${up}*xz
variable deltaxz equal -1e-06*xz
variable deltayz equal -${up}*yz
variable deltayz equal -1e-06*yz
if "${dir} == 1" then    "change_box all x delta 0 ${delta} xy delta ${deltaxy} xz delta ${deltaxz} remap units box"
if "${dir} == 2" then    "change_box all y delta 0 ${delta} yz delta ${deltayz} remap units box"
if "${dir} == 3" then    "change_box all z delta 0 ${delta} remap units box"
change_box all z delta 0 ${delta} remap units box
change_box all z delta 0 -7.16581650300664e-05 remap units box
Changing box ...
  triclinic box = (-0.0048245434 -0.0044523398 -0.004082515) to (71.654825 71.654452 71.654011) with tilt (0 0 0)
if "${dir} == 4" then    "change_box all yz delta ${delta} remap units box"
if "${dir} == 5" then    "change_box all xz delta ${delta} remap units box"
if "${dir} == 6" then    "change_box all xy delta ${delta} remap units box"

# Relax atoms positions

minimize ${etol} ${ftol} ${maxiter} ${maxeval}
minimize 0 ${ftol} ${maxiter} ${maxeval}
minimize 0 1e-10 ${maxiter} ${maxeval}
minimize 0 1e-10 100 ${maxeval}
minimize 0 1e-10 100 1000
