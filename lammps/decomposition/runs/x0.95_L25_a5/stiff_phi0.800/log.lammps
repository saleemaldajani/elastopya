variable pxz1 equal 2.20534011902825
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -8.58063517800847

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 20559.9525691694
variable C2neg equal ${d2}
variable C2neg equal 21253.0130379804
variable C3neg equal ${d3}
variable C3neg equal 20332.8500970498
