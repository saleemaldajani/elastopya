RELAXED_BOX 71.6996551253001 71.7004138776743 71.7004977719801

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--28.9271561373543)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--28.9271561373543)/(v_delta/v_len0)*0.0001
