variable C5pos equal ${d5}
variable C5pos equal 105.00424710774
variable C6pos equal ${d6}
variable C6pos equal 89.538732502

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(11410.7350660858+${C1pos})
variable C15 equal 0.5*(11410.7350660858+-11410.7377242536)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(11315.9618914375+${C2pos})
variable C25 equal 0.5*(11315.9618914375+-11315.9611431136)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(11302.1021611098+${C3pos})
variable C35 equal 0.5*(11302.1021611098+-11302.1175372424)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
