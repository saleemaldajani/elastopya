RELAXED_BOX 71.7182904551005 71.7180857189272 71.716780812877

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-445.4648163503)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-445.4648163503)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-447.902135441349)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-447.902135441349)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
