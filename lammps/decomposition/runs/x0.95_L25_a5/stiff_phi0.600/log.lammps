variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 71.7201986680891
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 71.7235268054529
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 71.7197236076152
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7201986680891 71.7235268054529 71.7197236076152

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--58.9807505484173)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--58.9807505484173)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--86.6949550472783)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--86.6949550472783)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--56.2650412119233)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--56.2650412119233)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
