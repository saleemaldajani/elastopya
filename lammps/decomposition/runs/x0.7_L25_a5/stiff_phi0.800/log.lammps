# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -126860.833895034
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 1114.91815099364
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 1164.70103608876
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 1192.98389422978
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 987.06952266239
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -22.2596760439081
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -59.0407071969978
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -12.775569720053

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -112542.875224499
variable C2pos equal ${d2}
variable C2pos equal -108032.625841722
variable C3pos equal ${d3}
variable C3pos equal -107210.833589946
variable C4pos equal ${d4}
variable C4pos equal 419.39391484719
variable C5pos equal ${d5}
variable C5pos equal -216.67021585801
variable C6pos equal ${d6}
variable C6pos equal 810.0526641157

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(112879.049921077+${C1pos})
variable C13 equal 0.5*(112879.049921077+-112542.875224499)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(108368.946803762+${C2pos})
variable C23 equal 0.5*(108368.946803762+-108032.625841722)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(107763.670485262+${C3pos})
variable C33 equal 0.5*(107763.670485262+-107210.833589946)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(-419.48879185814+${C4pos})
variable C43 equal 0.5*(-419.48879185814+419.39391484719)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(216.45972396004+${C5pos})
variable C53 equal 0.5*(216.45972396004+-216.67021585801)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
