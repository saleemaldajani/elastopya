variable pyz1 equal -53.7460025907964

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -16556.0092597432
variable C2neg equal ${d2}
variable C2neg equal -10197.4844914656
variable C3neg equal ${d3}
variable C3neg equal -9436.91616975128
