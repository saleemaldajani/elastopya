# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -127672.343960849
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 27.7094881440741
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 75.7028090061376
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 11.0810253311447
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -3.65536990505993
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 0.417091956700452
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -2.88233211015076
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -14.8185938781568

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -21005.4057092836
variable C2pos equal ${d2}
variable C2pos equal -21016.253614233
variable C3pos equal ${d3}
variable C3pos equal -21145.9403487874
variable C4pos equal ${d4}
variable C4pos equal -79.9011212157399
variable C5pos equal ${d5}
variable C5pos equal 148.864090356923
variable C6pos equal ${d6}
variable C6pos equal 54.0733516216871

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(21005.3983346116+${C1pos})
variable C15 equal 0.5*(21005.3983346116+-21005.4057092836)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(21016.2665629283+${C2pos})
variable C25 equal 0.5*(21016.2665629283+-21016.253614233)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(21145.9207390773+${C3pos})
variable C35 equal 0.5*(21145.9207390773+-21145.9403487874)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(79.9027307189499+${C4pos})
variable C45 equal 0.5*(79.9027307189499+-79.9011212157399)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(67.5970675863795+${C5pos})
variable C55 equal 0.5*(67.5970675863795+148.864090356923)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
