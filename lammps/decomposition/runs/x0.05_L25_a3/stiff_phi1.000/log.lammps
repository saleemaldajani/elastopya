variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 71.41371649451
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 71.4141665721793
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 71.4199467181079
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.41371649451 71.4141665721793 71.4199467181079

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--194.964529574257)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--194.964529574257)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--207.391013188674)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--207.391013188674)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--282.531077992183)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--282.531077992183)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
