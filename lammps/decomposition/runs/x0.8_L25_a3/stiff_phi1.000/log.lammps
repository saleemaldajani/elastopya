# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128010.487885719
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 99.3437890424469
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 218.605871589225
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -46.7181486088862
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 126.143644147002
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 9.96789092853981
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 29.8589170124061
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 28.4940451169692

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 1572.830366042
variable C2pos equal ${d2}
variable C2pos equal 2317.44104185872
variable C3pos equal ${d3}
variable C3pos equal 3056.5567476809
variable C4pos equal ${d4}
variable C4pos equal -20.5042083520901
variable C5pos equal ${d5}
variable C5pos equal 135.39960504604
variable C6pos equal ${d6}
variable C6pos equal 74.1914367504391

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-1572.8274252082+${C1pos})
variable C15 equal 0.5*(-1572.8274252082+1572.830366042)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-2317.49990402235+${C2pos})
variable C25 equal 0.5*(-2317.49990402235+2317.44104185872)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-3056.5472963092+${C3pos})
variable C35 equal 0.5*(-3056.5472963092+3056.5567476809)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(20.5186594857899+${C4pos})
variable C45 equal 0.5*(20.5186594857899+-20.5042083520901)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(${C5neg}+${C5pos})
variable C55 equal 0.5*(81.6154550691099+${C5pos})
variable C55 equal 0.5*(81.6154550691099+135.39960504604)
