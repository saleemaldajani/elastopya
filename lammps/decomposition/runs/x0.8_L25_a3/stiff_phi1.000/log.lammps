# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128010.487867672
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 97.2752771702635
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 216.967522045488
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -49.6457539570917
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 124.504063422395
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 9.96764586976204
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 30.9442556813735
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 28.4940835638897

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 1736.6653204157
variable C2pos equal ${d2}
variable C2pos equal 2610.20157667927
variable C3pos equal ${d3}
variable C3pos equal 3220.5148201416
variable C4pos equal ${d4}
variable C4pos equal -20.50805304414
variable C5pos equal ${d5}
variable C5pos equal 26.8657381493
variable C6pos equal ${d6}
variable C6pos equal 74.2159426282161

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(-1408.9914504171+${C1pos})
variable C12 equal 0.5*(-1408.9914504171+1736.6653204157)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(-2024.73889293977+${C2pos})
variable C22 equal 0.5*(-2024.73889293977+2610.20157667927)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(-2892.5885077686+${C3pos})
variable C32 equal 0.5*(-2892.5885077686+3220.5148201416)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C42 equal 0.5*(${C4neg}+${C4pos})
variable C42 equal 0.5*(20.5148151668002+${C4pos})
variable C42 equal 0.5*(20.5148151668002+-20.50805304414)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C52 equal 0.5*(${C5neg}+${C5pos})
variable C52 equal 0.5*(-26.9184128489503+${C5pos})
variable C52 equal 0.5*(-26.9184128489503+26.8657381493)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
