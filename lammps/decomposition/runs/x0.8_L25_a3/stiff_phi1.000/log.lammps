# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128010.487885156
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 99.3437679191931
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 218.606126462147
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -46.7184221863905
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 126.143599481823
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 9.96794648801612
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 30.9439200528691
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 27.4089207284188

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 1572.8048787498
variable C2pos equal ${d2}
variable C2pos equal 2317.46839960915
variable C3pos equal ${d3}
variable C3pos equal 3056.5612141988
variable C4pos equal ${d4}
variable C4pos equal 88.00823050295
variable C5pos equal ${d5}
variable C5pos equal 26.8993009997402
variable C6pos equal ${d6}
variable C6pos equal 74.1858808028081

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(-1572.852416879+${C1pos})
variable C14 equal 0.5*(-1572.852416879+1572.8048787498)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(-2317.47304200116+${C2pos})
variable C24 equal 0.5*(-2317.47304200116+2317.46839960915)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(-3056.5428300086+${C3pos})
variable C34 equal 0.5*(-3056.5428300086+3056.5612141988)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(129.03109870491+${C4pos})
variable C44 equal 0.5*(129.03109870491+88.00823050295)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(-26.8848494089202+${C5pos})
variable C54 equal 0.5*(-26.8848494089202+26.8993009997402)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
