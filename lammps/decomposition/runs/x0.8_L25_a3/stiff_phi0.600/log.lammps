variable C5pos equal ${d5}
variable C5pos equal -618.49921656877
variable C6pos equal ${d6}
variable C6pos equal 939.20065894089

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(172785.871350435+${C1pos})
variable C15 equal 0.5*(172785.871350435+-172785.845127445)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(178185.586474673+${C2pos})
variable C25 equal 0.5*(178185.586474673+-178185.589259561)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(173398.638032698+${C3pos})
variable C35 equal 0.5*(173398.638032698+-173398.620107879)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
