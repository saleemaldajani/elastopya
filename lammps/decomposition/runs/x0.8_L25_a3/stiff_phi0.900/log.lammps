# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -127527.690085803
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 301.212436323421
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 311.009558028088
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 275.595318107256
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 317.032432834918
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 8.27740347434962
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 33.8970272852202
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 11.3368956159753

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -38077.9907227471
variable C2pos equal ${d2}
variable C2pos equal -37032.6881634916
variable C3pos equal ${d3}
variable C3pos equal -37411.2105956407
variable C4pos equal ${d4}
variable C4pos equal 471.24581495392
variable C5pos equal ${d5}
variable C5pos equal -60.9283425199799
variable C6pos equal ${d6}
variable C6pos equal -130.241028941973

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(${C1neg}+${C1pos})
variable C12 equal 0.5*(38410.3872294751+${C1pos})
variable C12 equal 0.5*(38410.3872294751+-38077.9907227471)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(${C2neg}+${C2pos})
variable C22 equal 0.5*(37613.3541615289+${C2pos})
variable C22 equal 0.5*(37613.3541615289+-37032.6881634916)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(${C3neg}+${C3pos})
variable C32 equal 0.5*(37743.7790511919+${C3pos})
variable C32 equal 0.5*(37743.7790511919+-37411.2105956407)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C42 equal 0.5*(${C4neg}+${C4pos})
variable C42 equal 0.5*(-471.23120373419+${C4pos})
variable C42 equal 0.5*(-471.23120373419+471.24581495392)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C52 equal 0.5*(${C5neg}+${C5pos})
variable C52 equal 0.5*(60.8771450690199+${C5pos})
variable C52 equal 0.5*(60.8771450690199+-60.9283425199799)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
