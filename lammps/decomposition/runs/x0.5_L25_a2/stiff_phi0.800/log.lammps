RELAXED_BOX 71.8636193910843 71.8678012140083 71.8518721147148

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--83.1740253035725)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--83.1740253035725)/(v_delta/v_len0)*0.0001
