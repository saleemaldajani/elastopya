variable pyz1 equal 8.64386199491387

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 28126.8726553851
variable C2neg equal ${d2}
variable C2neg equal 26296.1366366338
variable C3neg equal ${d3}
variable C3neg equal 26162.640436032
