# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -126510.175025148
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 226.820495694575
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 204.492098559915
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 238.450841169925
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 237.518547353885
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 13.7570991360469
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 31.2892463475097
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 8.64406729343571

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -27712.1179506486
variable C2pos equal ${d2}
variable C2pos equal -25881.4537219256
variable C3pos equal ${d3}
variable C3pos equal -25831.0559504992
variable C4pos equal ${d4}
variable C4pos equal -61.0207089506329
variable C5pos equal ${d5}
variable C5pos equal 235.20589056265
variable C6pos equal ${d6}
variable C6pos equal -464.880573510744

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C11 equal 0.5*(${C1neg}+${C1pos})
variable C11 equal 0.5*(28210.2880623244+${C1pos})
variable C11 equal 0.5*(28210.2880623244+-27712.1179506486)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C21 equal 0.5*(${C2neg}+${C2pos})
variable C21 equal 0.5*(26212.7996123814+${C2pos})
variable C21 equal 0.5*(26212.7996123814+-25881.4537219256)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C31 equal 0.5*(${C3neg}+${C3pos})
variable C31 equal 0.5*(26162.6896552083+${C3pos})
variable C31 equal 0.5*(26162.6896552083+-25831.0559504992)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C41 equal 0.5*(${C4neg}+${C4pos})
variable C41 equal 0.5*(60.994403242362+${C4pos})
variable C41 equal 0.5*(60.994403242362+-61.0207089506329)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C51 equal 0.5*(${C5neg}+${C5pos})
variable C51 equal 0.5*(-235.10443817762+${C5pos})
variable C51 equal 0.5*(-235.10443817762+235.20589056265)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
variable C61 equal 0.5*(${C6neg}+${C6pos})
variable C61 equal 0.5*(464.713441857584+${C6pos})
variable C61 equal 0.5*(464.713441857584+-464.880573510744)

# Delete dir to make sure it is not reused

variable dir delete

# uyy Perturbation

variable dir equal 2
include displace.mod
# NOTE: This script should not need to be
# modified. See in.elastic for more info.
#
# Find which reference length to use

if "${dir} == 1" then    "variable len0 equal ${lx0}"
if "${dir} == 2" then    "variable len0 equal ${ly0}"
variable len0 equal ${ly0}
variable len0 equal 71.9471243544735
if "${dir} == 3" then    "variable len0 equal ${lz0}"
if "${dir} == 4" then    "variable len0 equal ${lz0}"
if "${dir} == 5" then    "variable len0 equal ${lz0}"
if "${dir} == 6" then    "variable len0 equal ${ly0}"

# Reset box and simulation parameters

clear
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
box tilt large

The 'box' command has been removed and will be ignored

read_restart restart.equil
Reading restart file ...
  restart file = 22 Jul 2025, LAMMPS = 22 Jul 2025
  restoring atom style atomic from restart
  triclinic box = (-0.14653064 -0.14856218 -0.1521782) to (71.796531 71.798562 71.802178) with tilt (0 0 0)
  2 by 2 by 3 MPI processor grid
  pair style hybrid/overlay stores no restart info
  31250 atoms
  read_restart CPU = 0.015 seconds
include potential.mod
# NOTE: This script can be modified for different pair styles
# See in.elastic for more info.

# Choose potential
pair_style hybrid/overlay eam/alloy eam/fs
pair_coeff * * eam/alloy FeCr_d.eam.alloy.txt Fe Cr
pair_coeff * * eam/fs FeCr_s.eam.fs.txt Fe Cr

# Setup neighbor style
neighbor 1.0 nsq
neigh_modify once no every 1 delay 0 check yes

# Setup minimization style
min_style	     cg
min_modify	     dmax ${dmax} line quadratic
min_modify	     dmax 0.01 line quadratic

# Setup output
thermo		1
thermo_style custom step temp pe press pxx pyy pzz pxy pxz pyz lx ly lz vol
thermo_modify norm no

# Negative deformation

variable delta equal -${up}*${len0}
variable delta equal -1e-06*${len0}
variable delta equal -1e-06*71.9471243544735
