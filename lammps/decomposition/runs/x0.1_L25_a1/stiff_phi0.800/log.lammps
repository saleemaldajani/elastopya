variable C5pos equal ${d5}
variable C5pos equal -710.04658206568
variable C6pos equal ${d6}
variable C6pos equal 119.94394903756

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(-55396.9852038947+${C1pos})
variable C14 equal 0.5*(-55396.9852038947+55396.9831896992)
