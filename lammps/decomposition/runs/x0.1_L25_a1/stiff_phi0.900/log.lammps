print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.4795294448828 71.4850465896998 71.4829632091406

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--11.9437136105085)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--11.9437136105085)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-19.7319048092615)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-19.7319048092615)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--6.79003963206755)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--6.79003963206755)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
