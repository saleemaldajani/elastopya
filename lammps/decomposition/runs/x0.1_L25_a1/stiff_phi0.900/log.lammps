variable pxz1 equal -7.06892478082191
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -15.1558230099386

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -39019.8541884487
variable C2neg equal ${d2}
variable C2neg equal -39774.6939790304
variable C3neg equal ${d3}
variable C3neg equal -39464.1080828375
variable C4neg equal ${d4}
variable C4neg equal 115.13718789542
variable C5neg equal ${d5}
variable C5neg equal 315.749364152399
variable C6neg equal ${d6}
variable C6neg equal -297.32134251853

# Reset box and simulation parameters

clear
