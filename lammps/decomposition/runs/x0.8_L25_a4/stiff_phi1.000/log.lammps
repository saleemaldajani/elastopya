RELAXED_BOX 71.6608618082641 71.6564792633912 71.6744124150667

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--275.244391887894)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--275.244391887894)/(v_delta/v_len0)*0.0001
