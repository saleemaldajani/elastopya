RELAXED_BOX 71.7052803171058 71.7114210554236 71.699561576002

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--406.171910844364)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--406.171910844364)/(v_delta/v_len0)*0.0001
