print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7219798508181 71.7229728970586 71.7225645630422

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--0.0342161318410546)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--0.0342161318410546)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--0.158589710333057)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--0.158589710333057)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-0.145084680694127)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-0.145084680694127)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
