RELAXED_BOX 71.6973673440227 71.7125014137486 71.7244356467376

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-10.4958405530608)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-10.4958405530608)/(v_delta/v_len0)*0.0001
