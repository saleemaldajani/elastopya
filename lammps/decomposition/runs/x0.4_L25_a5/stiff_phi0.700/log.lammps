variable C5pos equal ${d5}
variable C5pos equal 219.152003567639
variable C6pos equal ${d6}
variable C6pos equal -382.27207979771

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(2292.3736317356+${C1pos})
variable C15 equal 0.5*(2292.3736317356+-2292.5225149102)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(4996.9316489129+${C2pos})
variable C25 equal 0.5*(4996.9316489129+-4996.9458935517)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(2548.5717809444+${C3pos})
variable C35 equal 0.5*(2548.5717809444+-2548.7599827621)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
