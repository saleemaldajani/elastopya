variable C4pos equal 205.48184984995
variable C5pos equal ${d5}
variable C5pos equal 110.4319983177
variable C6pos equal ${d6}
variable C6pos equal -670.481207491311

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-48740.3345922948+${C1pos})
variable C13 equal 0.5*(-48740.3345922948+49053.1145285763)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-54862.935904753+${C2pos})
variable C23 equal 0.5*(-54862.935904753+55175.8537005028)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-52803.4745931943+${C3pos})
variable C33 equal 0.5*(-52803.4745931943+53317.5128143668)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(-205.5171756973+${C4pos})
variable C43 equal 0.5*(-205.5171756973+205.48184984995)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
