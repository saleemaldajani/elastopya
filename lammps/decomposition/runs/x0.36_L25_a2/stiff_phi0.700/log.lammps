# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -126946.713407288
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -142.329604820726
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -206.951273065634
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -54.4851126284915
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -165.552428768052
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 12.8324834518329
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -79.9869436851925
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -10.2500669197963

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 22653.4193207155
variable C2pos equal ${d2}
variable C2pos equal 19660.3533590096
variable C3pos equal ${d3}
variable C3pos equal 21756.3092169649
variable C4pos equal ${d4}
variable C4pos equal 859.582335951076
variable C5pos equal ${d5}
variable C5pos equal -118.09312347538
variable C6pos equal ${d6}
variable C6pos equal -104.16847869187

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-22326.0794706637+${C1pos})
variable C13 equal 0.5*(-22326.0794706637+22653.4193207155)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-19332.9741201562+${C2pos})
variable C23 equal 0.5*(-19332.9741201562+19660.3533590096)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-21258.0501012279+${C3pos})
variable C33 equal 0.5*(-21258.0501012279+21756.3092169649)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(-859.605850713736+${C4pos})
variable C43 equal 0.5*(-859.605850713736+859.582335951076)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(117.845244393411+${C5pos})
variable C53 equal 0.5*(117.845244393411+-118.09312347538)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
