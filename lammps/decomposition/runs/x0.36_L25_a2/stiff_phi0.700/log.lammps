RELAXED_BOX 71.875451803368 71.8730038259734 71.8747792588732

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-19.5829201415212)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-19.5829201415212)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-142.118420961604)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-142.118420961604)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
