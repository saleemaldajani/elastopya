RELAXED_BOX 71.8070867016162 71.7969068679203 71.7998778028365

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--228.604530477878)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--228.604530477878)/(v_delta/v_len0)*0.0001
