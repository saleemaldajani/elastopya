print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.8538691402726 71.8706153574592 71.8680548767727

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-27.5731691317192)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-27.5731691317192)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-12.8218110236221)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-12.8218110236221)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-4.40145638402713)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-4.40145638402713)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
