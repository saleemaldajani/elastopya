# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -126762.527780641
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -389.82886093364
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -319.263010942235
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -453.542321167449
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -396.681250691234
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 23.081422545897
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 14.846416590585
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -5.53167483119557

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 15782.4079642468
variable C2pos equal ${d2}
variable C2pos equal 13432.0850688042
variable C3pos equal ${d3}
variable C3pos equal 13924.7590609511
variable C4pos equal ${d4}
variable C4pos equal 688.800267166929
variable C5pos equal ${d5}
variable C5pos equal -224.13631280448
variable C6pos equal ${d6}
variable C6pos equal 471.37130414137

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-15453.6855151765+${C1pos})
variable C13 equal 0.5*(-15453.6855151765+15782.4079642468)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-13103.623351811+${C2pos})
variable C23 equal 0.5*(-13103.623351811+13432.0850688042)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-13429.8065395619+${C3pos})
variable C33 equal 0.5*(-13429.8065395619+13924.7590609511)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(-688.771279514391+${C4pos})
variable C43 equal 0.5*(-688.771279514391+688.800267166929)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(224.2288043331+${C5pos})
variable C53 equal 0.5*(224.2288043331+-224.13631280448)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
