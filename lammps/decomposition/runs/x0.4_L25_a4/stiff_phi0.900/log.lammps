# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -127729.433549598
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -425.043639630227
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -437.778557360021
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -406.691490735432
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -430.660870795229
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -32.2279241800041
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 72.1596120756032
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -99.1227460621206

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 36790.5279111911
variable C2pos equal ${d2}
variable C2pos equal 37178.7760897335
variable C3pos equal ${d3}
variable C3pos equal 36177.2820272659
variable C4pos equal ${d4}
variable C4pos equal -463.73827925504
variable C5pos equal ${d5}
variable C5pos equal 41.4880425757488
variable C6pos equal ${d6}
variable C6pos equal -26.66544193753

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-36469.0688345117+${C1pos})
variable C13 equal 0.5*(-36469.0688345117+36790.5279111911)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-36857.584662259+${C2pos})
variable C23 equal 0.5*(-36857.584662259+37178.7760897335)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-35664.2799450057+${C3pos})
variable C33 equal 0.5*(-35664.2799450057+36177.2820272659)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(463.529402159099+${C4pos})
variable C43 equal 0.5*(463.529402159099+-463.73827925504)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(-41.4521426421388+${C5pos})
variable C53 equal 0.5*(-41.4521426421388+41.4880425757488)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
