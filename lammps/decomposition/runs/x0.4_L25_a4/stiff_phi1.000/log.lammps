variable pxy1 equal -40.6130626583674
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 144.259947623407
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -111.395438468223

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 42017.1012319587
variable C2pos equal ${d2}
variable C2pos equal 42100.1590832729
variable C3pos equal ${d3}
variable C3pos equal 42514.8925773415
