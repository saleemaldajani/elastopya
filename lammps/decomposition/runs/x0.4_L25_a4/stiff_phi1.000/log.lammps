variable C4pos equal 140.5810475398
variable C5pos equal ${d5}
variable C5pos equal -4.69008262080024
variable C6pos equal ${d6}
variable C6pos equal -18.0303727624704

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-41859.7087994905+${C1pos})
variable C15 equal 0.5*(-41859.7087994905+41859.7544543338)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-41942.9610545091+${C2pos})
variable C25 equal 0.5*(-41942.9610545091+41942.8323393596)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-42255.3498108363+${C3pos})
variable C35 equal 0.5*(-42255.3498108363+42255.4464468089)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
