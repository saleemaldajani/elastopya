variable C5pos equal ${d5}
variable C5pos equal -115.722593370299
variable C6pos equal ${d6}
variable C6pos equal -18.0405656793404

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-41702.3611434117+${C1pos})
variable C13 equal 0.5*(-41702.3611434117+42017.1012319587)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-41785.6338387123+${C2pos})
variable C23 equal 0.5*(-41785.6338387123+42100.1590832729)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-41995.9035857197+${C3pos})
variable C33 equal 0.5*(-41995.9035857197+42514.8925773415)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
