variable C23 equal 0.5*(112429.896437908+-112093.371041429)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(113435.250988838+${C3pos})
variable C33 equal 0.5*(113435.250988838+-112882.676020982)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
