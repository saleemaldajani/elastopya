variable C5pos equal ${d5}
variable C5pos equal -635.98269428332
variable C6pos equal ${d6}
variable C6pos equal 551.333571652859

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(112167.698747454+${C1pos})
variable C15 equal 0.5*(112167.698747454+-112167.781773787)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(112261.63033373+${C2pos})
variable C25 equal 0.5*(112261.63033373+-112261.636616781)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(113158.914486758+${C3pos})
variable C35 equal 0.5*(113158.914486758+-113159.011715557)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
