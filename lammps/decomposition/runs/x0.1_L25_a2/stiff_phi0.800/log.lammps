variable pxz1 equal 22.0664072412037
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 21.4936330933055

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal -79140.7176002065
variable C2neg equal ${d2}
variable C2neg equal -78470.4774856522
variable C3neg equal ${d3}
variable C3neg equal -79057.8828395923
variable C4neg equal ${d4}
variable C4neg equal -41.23743340589
variable C5neg equal ${d5}
variable C5neg equal 10.9029535511898
variable C6neg equal ${d6}
variable C6neg equal -3.15111838400028

# Reset box and simulation parameters

clear
