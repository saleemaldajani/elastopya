variable C5pos equal ${d5}
variable C5pos equal -112.930981889441
variable C6pos equal ${d6}
variable C6pos equal 515.60608658836

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-62747.154011463+${C1pos})
variable C13 equal 0.5*(-62747.154011463+63047.1479005899)
