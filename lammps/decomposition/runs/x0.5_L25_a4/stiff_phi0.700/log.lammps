# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -126464.047339907
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 547.389260374232
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 519.826044354937
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 575.358451846024
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 546.983284921734
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -17.5957526468002
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -81.4418274217102
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -35.0278341662816

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -74310.3300417211
variable C2pos equal ${d2}
variable C2pos equal -78091.9014103806
variable C3pos equal ${d3}
variable C3pos equal -76656.1703634071
variable C4pos equal ${d4}
variable C4pos equal -27.8285153743497
variable C5pos equal ${d5}
variable C5pos equal 330.264508485421
variable C6pos equal ${d6}
variable C6pos equal -959.43633419693

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(74310.2170084329+${C1pos})
variable C15 equal 0.5*(74310.2170084329+-74310.3300417211)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(78091.9859842088+${C2pos})
variable C25 equal 0.5*(78091.9859842088+-78091.9014103806)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(76656.0337202684+${C3pos})
variable C35 equal 0.5*(76656.0337202684+-76656.1703634071)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(27.8700226643998+${C4pos})
variable C45 equal 0.5*(27.8700226643998+-27.8285153743497)
