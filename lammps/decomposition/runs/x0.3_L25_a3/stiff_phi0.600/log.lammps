print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.8665263059444 71.8653242687213 71.8645071755527

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-5.72746418335164)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-5.72746418335164)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-90.5980984737468)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-90.5980984737468)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
