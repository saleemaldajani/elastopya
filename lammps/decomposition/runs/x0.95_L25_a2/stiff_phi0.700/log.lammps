RELAXED_BOX 71.7184621758893 71.720542032991 71.7139025018405

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--202.682566617742)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--202.682566617742)/(v_delta/v_len0)*0.0001
