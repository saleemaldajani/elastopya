print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7209453489932 71.7153691408594 71.7169114041607

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-330.860540445981)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-330.860540445981)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-450.657865170077)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-450.657865170077)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-380.128219897955)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-380.128219897955)/(v_delta/v_len0)*0.0001
