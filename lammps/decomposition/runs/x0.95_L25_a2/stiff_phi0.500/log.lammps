variable pxy0 equal ${tmp}
variable pxy0 equal 3.23378444263783

variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 71.7279673775961
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 71.7180968495774
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 71.7168656703986
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7279673775961 71.7180968495774 71.7168656703986

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--136.67001936957)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--136.67001936957)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-43.499471189972)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-43.499471189972)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-73.6519131281639)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-73.6519131281639)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
