RELAXED_BOX 71.857605817414 71.8558266160415 71.8622591797494

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--169.031563959027)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--169.031563959027)/(v_delta/v_len0)*0.0001
