RELAXED_BOX 71.8701708342473 71.8859604527974 71.8872023391998

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--86.6964758888219)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--86.6964758888219)/(v_delta/v_len0)*0.0001
