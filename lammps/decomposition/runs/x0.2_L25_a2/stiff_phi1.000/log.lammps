# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128556.196214
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -469.842305957884
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -439.922624635998
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -495.71510967129
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -473.889183566363
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 3.90671551443153
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -49.6827110459314
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -103.215216348337

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 44899.9514870304
variable C2pos equal ${d2}
variable C2pos equal 48578.1119021781
variable C3pos equal ${d3}
variable C3pos equal 47393.7054882099
variable C4pos equal ${d4}
variable C4pos equal 102.965197908
variable C5pos equal ${d5}
variable C5pos equal 230.20571314835
variable C6pos equal ${d6}
variable C6pos equal 46.59939555065

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-44899.9686195463+${C1pos})
variable C15 equal 0.5*(-44899.9686195463+44899.9514870304)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-48578.0789008209+${C2pos})
variable C25 equal 0.5*(-48578.0789008209+48578.1119021781)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-47393.7591618026+${C3pos})
variable C35 equal 0.5*(-47393.7591618026+47393.7054882099)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(-102.9695511881+${C4pos})
variable C45 equal 0.5*(-102.9695511881+102.965197908)
