variable C5pos equal -110.798849892746
variable C6pos equal ${d6}
variable C6pos equal -163.85595147437

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(98859.6054222351+${C1pos})
variable C15 equal 0.5*(98859.6054222351+-98859.5488784891)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(97751.2345749765+${C2pos})
variable C25 equal 0.5*(97751.2345749765+-97751.2083153965)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
