print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7679613165734 71.773363365243 71.7726556710685

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--364.915634313508)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--364.915634313508)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--445.20467884702)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--445.20467884702)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--434.136333713287)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--434.136333713287)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
