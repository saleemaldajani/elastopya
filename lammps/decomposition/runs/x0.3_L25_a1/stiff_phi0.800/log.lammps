print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7475886349935 71.7480820131741 71.7507986188585

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-10.9514256193132)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-10.9514256193132)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-10.6226453913326)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-10.6226453913326)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-69.9342571390551)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-69.9342571390551)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
