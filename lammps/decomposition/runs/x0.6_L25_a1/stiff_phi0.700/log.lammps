variable C5pos equal ${d5}
variable C5pos equal -885.67579004663
variable C6pos equal ${d6}
variable C6pos equal 368.95217038176

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(133278.900253721+${C1pos})
variable C15 equal 0.5*(133278.900253721+-133278.943572531)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(134249.948103187+${C2pos})
variable C25 equal 0.5*(134249.948103187+-134249.981292889)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(133263.954984595+${C3pos})
variable C35 equal 0.5*(133263.954984595+-133264.023795426)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
