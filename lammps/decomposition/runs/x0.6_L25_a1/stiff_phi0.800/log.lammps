variable pxy1 equal -49.8056587456039
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -20.7435282116047
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 10.4744387960536

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -89812.1578169796
variable C2pos equal ${d2}
variable C2pos equal -87835.4704642823
variable C3pos equal ${d3}
variable C3pos equal -87447.4369737858
