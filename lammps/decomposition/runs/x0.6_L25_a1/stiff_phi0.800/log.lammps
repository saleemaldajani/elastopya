variable C5pos equal ${d5}
variable C5pos equal 344.65849984518
variable C6pos equal ${d6}
variable C6pos equal 718.099065297131

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(90146.8914740566+${C1pos})
variable C13 equal 0.5*(90146.8914740566+-89812.1578169796)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(88170.2698785443+${C2pos})
variable C23 equal 0.5*(88170.2698785443+-87835.4704642823)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(87980.3046370318+${C3pos})
variable C33 equal 0.5*(87980.3046370318+-87447.4369737858)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
