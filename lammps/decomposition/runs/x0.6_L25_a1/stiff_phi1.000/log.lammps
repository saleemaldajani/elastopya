variable pxy1 equal -13.2412368968235
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -59.8486189896139
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal 51.998333556469

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 22415.5605223482
variable C2pos equal ${d2}
variable C2pos equal 20525.6121999568
variable C3pos equal ${d3}
variable C3pos equal 24231.2301992966
