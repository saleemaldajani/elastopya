variable C5pos equal ${d5}
variable C5pos equal 3.86715551832992
variable C6pos equal ${d6}
variable C6pos equal -24.4454632828798

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-25365.2400382832+${C1pos})
variable C15 equal 0.5*(-25365.2400382832+25365.2318491606)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-23631.6728860282+${C2pos})
variable C25 equal 0.5*(-23631.6728860282+23631.7152084851)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(-24648.7088100406+${C3pos})
variable C35 equal 0.5*(-24648.7088100406+24648.6805950839)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
