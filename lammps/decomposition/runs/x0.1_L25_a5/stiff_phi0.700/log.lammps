variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(581.04303520958+${C5pos})
variable C53 equal 0.5*(581.04303520958+-581.10061156489)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
