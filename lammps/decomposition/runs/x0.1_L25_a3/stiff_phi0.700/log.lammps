RELAXED_BOX 71.5434038257966 71.5438101269638 71.5432823606277

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-53.5122671428438)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-53.5122671428438)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-57.3147034388637)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-57.3147034388637)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-40.3967363065153)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-40.3967363065153)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
