variable C5pos equal ${d5}
variable C5pos equal 160.46801278041
variable C6pos equal ${d6}
variable C6pos equal 40.2125392647292

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-32194.5090989957+${C1pos})
variable C13 equal 0.5*(-32194.5090989957+32492.0333815715)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-30573.1216411934+${C2pos})
variable C23 equal 0.5*(-30573.1216411934+30870.7022900803)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-31698.0040310392+${C3pos})
variable C33 equal 0.5*(-31698.0040310392+32188.9185925787)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
