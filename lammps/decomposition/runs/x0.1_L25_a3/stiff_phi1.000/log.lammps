RELAXED_BOX 71.4479517866728 71.437870112849 71.4404587619748

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--70.9705538746725)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--70.9705538746725)/(v_delta/v_len0)*0.0001
