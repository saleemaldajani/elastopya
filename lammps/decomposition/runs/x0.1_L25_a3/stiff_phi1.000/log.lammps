variable C5pos equal 275.01947447093
variable C6pos equal ${d6}
variable C6pos equal 40.2093553535494

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(-32343.2930918797+${C1pos})
variable C15 equal 0.5*(-32343.2930918797+32343.2501653018)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(-30721.8846406719+${C2pos})
variable C25 equal 0.5*(-30721.8846406719+30721.9397664293)
