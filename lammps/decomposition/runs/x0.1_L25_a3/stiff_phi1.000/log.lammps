variable pxy1 equal -84.8080644929853
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -80.5034730094219
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -37.88666508014

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 32492.0333815715
variable C2pos equal ${d2}
variable C2pos equal 30870.7022900803
variable C3pos equal ${d3}
variable C3pos equal 32188.9185925787
