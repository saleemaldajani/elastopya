RELAXED_BOX 71.9372402532039 71.9299108342094 71.937035292519

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-111.918405612572)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-111.918405612572)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-70.5647482603837)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-70.5647482603837)/(v_delta/v_len0)*0.0001
