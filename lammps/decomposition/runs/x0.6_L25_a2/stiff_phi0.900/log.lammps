RELAXED_BOX 71.7663975802606 71.7548199950649 71.7563241304655

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-8.479242430312)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-8.479242430312)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-198.121782128475)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-198.121782128475)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
