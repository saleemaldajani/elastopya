variable C25 equal 0.5*(27458.2369094732+-27458.2120310511)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(26847.9980147869+${C3pos})
variable C35 equal 0.5*(26847.9980147869+-26847.9367038859)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(1827.19601542776+${C4pos})
variable C45 equal 0.5*(1827.19601542776+-1827.20907454427)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
