# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -128076.692672155
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal -75.8320372274735
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -69.6347157394955
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 16.7012678281012
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -174.562663771026
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -41.2632554401125
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -9.78210741121925
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -39.0453828481281

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal 20922.866995632
variable C2pos equal ${d2}
variable C2pos equal 25485.4414238751
variable C3pos equal ${d3}
variable C3pos equal 25814.445663764
variable C4pos equal ${d4}
variable C4pos equal -319.9963813014
variable C5pos equal ${d5}
variable C5pos equal -434.825786305195
variable C6pos equal ${d6}
variable C6pos equal -2.90399721884995

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-20599.8245482703+${C1pos})
variable C13 equal 0.5*(-20599.8245482703+20922.866995632)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-25162.7390887766+${C2pos})
variable C23 equal 0.5*(-25162.7390887766+25485.4414238751)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-25267.5280533986+${C3pos})
variable C33 equal 0.5*(-25267.5280533986+25814.445663764)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(319.9487373385+${C4pos})
variable C43 equal 0.5*(319.9487373385+-319.9963813014)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(${C5neg}+${C5pos})
variable C53 equal 0.5*(434.813476776496+${C5pos})
variable C53 equal 0.5*(434.813476776496+-434.825786305195)
variable C6${dir} equal 0.5*(${C6neg}+${C6pos})
