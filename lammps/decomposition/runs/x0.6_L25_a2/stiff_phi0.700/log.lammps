# Obtain new stress tensor

variable tmp equal pe
variable e1 equal ${tmp}
variable e1 equal -126324.632445093
variable tmp equal press
variable p1 equal ${tmp}
variable p1 equal 1686.83014490742
variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal 1734.21100612389
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal 1695.35234599387
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal 1630.92708260452
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal 1.81436398762585
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal -10.0938887819241
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -17.0751911322214

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -136657.986633195
variable C2pos equal ${d2}
variable C2pos equal -133320.591440077
variable C3pos equal ${d3}
variable C3pos equal -136931.804602915
variable C4pos equal ${d4}
variable C4pos equal -1130.41803954083
variable C5pos equal ${d5}
variable C5pos equal 980.895466605296
variable C6pos equal ${d6}
variable C6pos equal -370.407252614166

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(136658.059127847+${C1pos})
variable C15 equal 0.5*(136658.059127847+-136657.986633195)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(133320.715355354+${C2pos})
variable C25 equal 0.5*(133320.715355354+-133320.591440077)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(136931.849581624+${C3pos})
variable C35 equal 0.5*(136931.849581624+-136931.804602915)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(1130.39319119741+${C4pos})
variable C45 equal 0.5*(1130.39319119741+-1130.41803954083)
