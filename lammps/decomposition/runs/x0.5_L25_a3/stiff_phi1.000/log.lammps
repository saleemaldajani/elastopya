print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.6154317245902 71.61048567599 71.6142349541284

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--103.970111645901)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--103.970111645901)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--100.947188707395)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--100.947188707395)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--87.9869637782905)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--87.9869637782905)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
