RELAXED_BOX 71.8629247199621 71.862031589283 71.8705533193979

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--15.6639118129773)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--15.6639118129773)/(v_delta/v_len0)*0.0001
