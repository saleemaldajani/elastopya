print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7414276569231 71.7428413313634 71.740939737275

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-32.7665662587083)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-32.7665662587083)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--35.0228011694484)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--35.0228011694484)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-76.4862477544049)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-76.4862477544049)/(v_delta/v_len0)*0.0001
