variable C5pos equal ${d5}
variable C5pos equal -1302.63895150588
variable C6pos equal ${d6}
variable C6pos equal 134.067828832508

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-101829.340012174+${C1pos})
variable C13 equal 0.5*(-101829.340012174+102144.56394826)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-103732.890096109+${C2pos})
variable C23 equal 0.5*(-103732.890096109+104048.239676946)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-105766.948620594+${C3pos})
variable C33 equal 0.5*(-105766.948620594+106258.560677203)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
