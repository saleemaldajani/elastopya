variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 71.5119069848332
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 71.4883644590564
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 71.4974502708079
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.5119069848332 71.4883644590564 71.4974502708079

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--412.312303170203)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1--412.312303170203)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--111.992288124868)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1--111.992288124868)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--189.276810077038)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1--189.276810077038)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
