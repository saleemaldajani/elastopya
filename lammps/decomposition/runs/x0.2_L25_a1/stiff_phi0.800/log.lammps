variable C5pos equal ${d5}
variable C5pos equal 819.68764312206
variable C6pos equal ${d6}
variable C6pos equal 164.54155293736

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(-91692.1361100114+${C1pos})
variable C13 equal 0.5*(-91692.1361100114+92004.3082640384)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(-91715.057902526+${C2pos})
variable C23 equal 0.5*(-91715.057902526+92027.1606128627)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(-91425.6501600362+${C3pos})
variable C33 equal 0.5*(-91425.6501600362+91918.8848455214)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
