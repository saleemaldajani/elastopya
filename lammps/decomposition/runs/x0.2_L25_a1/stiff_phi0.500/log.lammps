variable tmp equal lx
variable lx0 equal ${tmp}
variable lx0 equal 71.7325792542349
variable tmp equal ly
variable ly0 equal ${tmp}
variable ly0 equal 71.7341430057906
variable tmp equal lz
variable lz0 equal ${tmp}
variable lz0 equal 71.7402222936276
print "RELAXED_BOX ${lx0} ${ly0} ${lz0}"   # added: record relaxed cell for density
RELAXED_BOX 71.7325792542349 71.7341430057906 71.7402222936276

# These formulas define the derivatives w.r.t. strain components
# Constants uses $, variables use v_
variable d1 equal -(v_pxx1-${pxx0})/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-40.3587019291927)/(v_delta/v_len0)*${cfac}
variable d1 equal -(v_pxx1-40.3587019291927)/(v_delta/v_len0)*0.0001
variable d2 equal -(v_pyy1-${pyy0})/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-37.7182401006165)/(v_delta/v_len0)*${cfac}
variable d2 equal -(v_pyy1-37.7182401006165)/(v_delta/v_len0)*0.0001
variable d3 equal -(v_pzz1-${pzz0})/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-28.4664878578249)/(v_delta/v_len0)*${cfac}
variable d3 equal -(v_pzz1-28.4664878578249)/(v_delta/v_len0)*0.0001
variable d4 equal -(v_pyz1-${pyz0})/(v_delta/v_len0)*${cfac}
