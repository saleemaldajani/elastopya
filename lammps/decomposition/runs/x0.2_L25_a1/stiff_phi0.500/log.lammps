variable C4pos equal 1194.82827548052
variable C5pos equal ${d5}
variable C5pos equal 1507.57502415581
variable C6pos equal ${d6}
variable C6pos equal 501.090874853205

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(${C1neg}+${C1pos})
variable C14 equal 0.5*(-98388.2938818935+${C1pos})
variable C14 equal 0.5*(-98388.2938818935+98388.3487864308)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(${C2neg}+${C2pos})
variable C24 equal 0.5*(-100073.383479574+${C2pos})
variable C24 equal 0.5*(-100073.383479574+100073.444494363)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(${C3neg}+${C3pos})
variable C34 equal 0.5*(-102971.601742975+${C3pos})
variable C34 equal 0.5*(-102971.601742975+102971.654024615)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(${C4neg}+${C4pos})
variable C44 equal 0.5*(-972.757251460135+${C4pos})
variable C44 equal 0.5*(-972.757251460135+1194.82827548052)
variable C5${dir} equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(${C5neg}+${C5pos})
variable C54 equal 0.5*(-1507.56833566379+${C5pos})
variable C54 equal 0.5*(-1507.56833566379+1507.57502415581)
