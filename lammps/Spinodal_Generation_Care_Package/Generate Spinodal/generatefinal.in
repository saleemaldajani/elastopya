# ------------------------ INITIALIZATION ----------------------------

units metal
dimension 3
boundary p p p
atom_style full

lattice bcc 2.866     #Fe lattice param

variable L equal 50
region SYSTEM block 0 ${L} 0 ${L} 0 ${L} units lattice
create_box 2 SYSTEM
create_atoms 1 region SYSTEM

mass 1 55.85 #Fe
mass 2 51.996 #Cr

set group all type/fraction 2 0.5 38507825 #This sets half of the atoms from type 1 to type 2 with random seed number
group G22 type 2
group G11 type 1

#-------------------------Interatomic Potential------------------------------------

pair_style lj/cut 2.866

#Set the energy for like neighbours to 0, and the energy for unlike neighbours to a positive value
#So the energy of the energy of the system drops when like atoms group together (like spinodal decomposition)
pair_coeff 1 1 0.0 0.0 2.866
pair_coeff 2 2 0.0 0.0 2.866
pair_coeff 1 2 10 10 2.866


#--------------------------------Output-------------------------------------
#Swaps 3000 atoms every 50 timesteps, at 10K with random seed number. This will swap atoms in a way that reduces the energy of the system.
fix 3 all atom/swap 50 3000 97705767 10 types 1 2

thermo_style custom step pe etotal #Outputs the energy so you can see it dropping
thermo 1000
dump 1 all xyz 1000 output.xyz

timestep 0.01 #Irrelevant for this but must be set
run 40000     #Need to run for long enough for it to swap enough atoms to minimise energy, balance with time, for bigger or smaller system you will need more or less respectively
