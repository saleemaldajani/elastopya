\@writefile{lof}{\contentsline {figure}{\numberline {S33}{\ignorespaces Phonon dispersion of Cr against neutron scattering at 300 K (Shaw and Muhlestein \cite  {shaw1971investigation}, digitized; Cr is AFM at 300 K): DFPT for NM Cr ($k=24^3$) and commensurate AFM Cr (2-atom simple-cubic cell, branches folded onto the \textit  {bcc} path where the lines coincide), each at the relaxed and the experimental lattice parameter. RMS deviations 0.35--0.41 THz.\relax }}{38}{figure.caption.54}\protected@file@percent }
\newlabel{fig:V_phdisp_Cr}{{S33}{38}{Phonon dispersion of Cr against neutron scattering at 300 K (Shaw and Muhlestein \cite {shaw1971investigation}, digitized; Cr is AFM at 300 K): DFPT for NM Cr ($k=24^3$) and commensurate AFM Cr (2-atom simple-cubic cell, branches folded onto the \textit {bcc} path where the lines coincide), each at the relaxed and the experimental lattice parameter. RMS deviations 0.35--0.41 THz.\relax }{figure.caption.54}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S34}{\ignorespaces Phonon DOS of Cr (DFPT, NM and AFM, unit area) against the Born--von K\'arm\'an DOS of Fultz \textit  {et al.}\ \cite  {fultz1995phonon}, which is calculated from force constants fitted to neutron dispersions (not a measured spectrum). Mean frequencies are 6\% (NM) and 3\% (AFM) higher.\relax }}{38}{figure.caption.55}\protected@file@percent }
\newlabel{fig:V_phdos_Cr}{{S34}{38}{Phonon DOS of Cr (DFPT, NM and AFM, unit area) against the Born--von K\'arm\'an DOS of Fultz \textit {et al.}\ \cite {fultz1995phonon}, which is calculated from force constants fitted to neutron dispersions (not a measured spectrum). Mean frequencies are 6\% (NM) and 3\% (AFM) higher.\relax }{figure.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S35}{\ignorespaces Phonon dispersion of FM Fe against neutron scattering at 295 K (Minkiewicz \textit  {et al.}\ \cite  {minkiewicz1967phonon}, tabulated): DFPT and finite displacements, each at the relaxed and the experimental lattice parameter. DFPT is too stiff (RMS 1.4 and 1.1 THz); finite displacements agree (RMS 0.46 and 0.23 THz). Fe phonons are computed by finite displacements (phonopy; 0.01 \r A\ displacement in a cubic $3\times 3\times 3$ conventional supercell of 54 atoms, same PBE-PAW settings, $k=5^3$), because density-functional perturbation theory (QE \texttt  {ph.x}) gave frequencies about 60\% too high for ferromagnetic Fe while a frozen phonon with identical settings agreed with neutron scattering to 2\% (4.40 vs 4.31 THz for the transverse mode at $\zeta =1/3$ along $\Gamma $--H). A $2\times 2\times 5$ supercell was not used: its tetragonal shape made the symmetrised force constants inconsistent and produced a spurious imaginary branch.\relax }}{39}{figure.caption.56}\protected@file@percent }
\newlabel{fig:V_phdisp_Fe}{{S35}{39}{Phonon dispersion of FM Fe against neutron scattering at 295 K (Minkiewicz \textit {et al.}\ \cite {minkiewicz1967phonon}, tabulated): DFPT and finite displacements, each at the relaxed and the experimental lattice parameter. DFPT is too stiff (RMS 1.4 and 1.1 THz); finite displacements agree (RMS 0.46 and 0.23 THz). Fe phonons are computed by finite displacements (phonopy; 0.01 \AA \ displacement in a cubic $3\times 3\times 3$ conventional supercell of 54 atoms, same PBE-PAW settings, $k=5^3$), because density-functional perturbation theory (QE \texttt {ph.x}) gave frequencies about 60\% too high for ferromagnetic Fe while a frozen phonon with identical settings agreed with neutron scattering to 2\% (4.40 vs 4.31 THz for the transverse mode at $\zeta =1/3$ along $\Gamma $--H). A $2\times 2\times 5$ supercell was not used: its tetragonal shape made the symmetrised force constants inconsistent and produced a spurious imaginary branch.\relax }{figure.caption.56}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S36}{\ignorespaces Phonon DOS of FM Fe (unit area) against NRIXS at 30 and 300 K (Mauger \textit  {et al.}\ \cite  {mauger2014nonharmonic}) and the force-constant DOS of Fultz \textit  {et al.}\ \cite  {fultz1995phonon}. Mean frequencies relative to the 300 K NRIXS DOS: DFPT $+27\%$ (relaxed) and $+19\%$ (experimental lattice parameter); finite displacements $+7.8\%$ and $-0.1\%$. The finite-displacement result at the experimental lattice parameter is used for Fe.\relax }}{40}{figure.caption.57}\protected@file@percent }
\newlabel{fig:V_phdos_Fe}{{S36}{40}{Phonon DOS of FM Fe (unit area) against NRIXS at 30 and 300 K (Mauger \textit {et al.}\ \cite {mauger2014nonharmonic}) and the force-constant DOS of Fultz \textit {et al.}\ \cite {fultz1995phonon}. Mean frequencies relative to the 300 K NRIXS DOS: DFPT $+27\%$ (relaxed) and $+19\%$ (experimental lattice parameter); finite displacements $+7.8\%$ and $-0.1\%$. The finite-displacement result at the experimental lattice parameter is used for Fe.\relax }{figure.caption.57}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S37}{\ignorespaces Validation of the thermal-transport estimates of Section S1. (a) Debye temperature: elastic (Anderson) from every tensor of this work and EMTO-CPA; from the second moment of the phonon DOS (Fultz \textit  {et al.}\ \cite  {fultz1995phonon}, NRIXS \cite  {mauger2014nonharmonic}, ours; this definition runs about 10\% below the elastic one); calorimetric values of Fe and Cr \cite  {kittel2005introduction}. (b) $D_{\qopname  \relax m{min}}=\kappa _{\qopname  \relax m{min}}/\rho c_p$ from Eq.\nobreakspace  {}(S2) of Section S1 for each tensor set; it is a lower bound on the lattice contribution. (c) Relative change of the thermal diffusivity: measured by TGS in CF8 after aging (circles, Fig.\nobreakspace  {}\ref  {fig5}d) and predicted by the S1 scaling for full decomposition of MD Fe--36Cr and Fe--50Cr (dashed). Script: \texttt  {dft\_qe/thermal\_check.py}.\relax }}{40}{figure.caption.58}\protected@file@percent }
\newlabel{fig:S_thermal}{{S37}{40}{Validation of the thermal-transport estimates of Section S1. (a) Debye temperature: elastic (Anderson) from every tensor of this work and EMTO-CPA; from the second moment of the phonon DOS (Fultz \textit {et al.}\ \cite {fultz1995phonon}, NRIXS \cite {mauger2014nonharmonic}, ours; this definition runs about 10\% below the elastic one); calorimetric values of Fe and Cr \cite {kittel2005introduction}. (b) $D_{\min }=\kappa _{\min }/\rho c_p$ from Eq.~(S2) of Section S1 for each tensor set; it is a lower bound on the lattice contribution. (c) Relative change of the thermal diffusivity: measured by TGS in CF8 after aging (circles, Fig.~\ref {fig5}d) and predicted by the S1 scaling for full decomposition of MD Fe--36Cr and Fe--50Cr (dashed). Script: \texttt {dft\_qe/thermal\_check.py}.\relax }{figure.caption.58}{}}
