\@writefile{lof}{\contentsline {figure}{\numberline {S25}{\ignorespaces Phonon dispersions of \textit  {bcc} Fe (FM), \textit  {bcc} Cr (NM, DFPT, $k=24^3$) and commensurate AFM Cr (DFPT, $k=12^3$, simple-cubic path), at the PBE-relaxed lattice parameters. All frequencies are real. Fe phonons are computed by finite displacements (phonopy; 0.01 \r A\ displacement in a cubic $3\times 3\times 3$ conventional supercell of 54 atoms, same PBE-PAW settings, $k=5^3$), because density-functional perturbation theory (QE \texttt  {ph.x}) gave frequencies about 60\% too high for ferromagnetic Fe while a frozen phonon with identical settings agreed with neutron scattering to 2\% (4.40 vs 4.31 THz for the transverse mode at $\zeta =1/3$ along $\Gamma $--H). A $2\times 2\times 5$ supercell was not used: its tetragonal shape made the symmetrised force constants inconsistent and produced a spurious imaginary branch. Cr is computed with DFPT, which agrees with neutron scattering (Fig.\nobreakspace  {}\ref  {fig:S_phonons_exp}); its non-magnetic phase needs $k=24^3$ (Fig.\nobreakspace  {}\ref  {fig:S_phonon_conv}).\relax }}{32}{figure.caption.43}\protected@file@percent }
\newlabel{fig:S_phonons}{{S25}{32}{Phonon dispersions of \textit {bcc} Fe (FM), \textit {bcc} Cr (NM, DFPT, $k=24^3$) and commensurate AFM Cr (DFPT, $k=12^3$, simple-cubic path), at the PBE-relaxed lattice parameters. All frequencies are real. Fe phonons are computed by finite displacements (phonopy; 0.01 \AA \ displacement in a cubic $3\times 3\times 3$ conventional supercell of 54 atoms, same PBE-PAW settings, $k=5^3$), because density-functional perturbation theory (QE \texttt {ph.x}) gave frequencies about 60\% too high for ferromagnetic Fe while a frozen phonon with identical settings agreed with neutron scattering to 2\% (4.40 vs 4.31 THz for the transverse mode at $\zeta =1/3$ along $\Gamma $--H). A $2\times 2\times 5$ supercell was not used: its tetragonal shape made the symmetrised force constants inconsistent and produced a spurious imaginary branch. Cr is computed with DFPT, which agrees with neutron scattering (Fig.~\ref {fig:S_phonons_exp}); its non-magnetic phase needs $k=24^3$ (Fig.~\ref {fig:S_phonon_conv}).\relax }{figure.caption.43}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S26}{\ignorespaces Brillouin-zone sampling of the NM Cr phonons. (a) Dispersion at an electronic $k$-mesh of $16^3$ (imaginary branches plotted below zero) and $24^3$ (all real). (b) Lowest frequency along the path for each setting: SCF mixing and a 0.4\% change of the lattice parameter have no effect, whereas a denser mesh or wider smearing removes the imaginary modes. They are an artefact of under-sampling the nested Fermi surface of Cr, not a dynamical instability.\relax }}{32}{figure.caption.44}\protected@file@percent }
\newlabel{fig:S_phonon_conv}{{S26}{32}{Brillouin-zone sampling of the NM Cr phonons. (a) Dispersion at an electronic $k$-mesh of $16^3$ (imaginary branches plotted below zero) and $24^3$ (all real). (b) Lowest frequency along the path for each setting: SCF mixing and a 0.4\% change of the lattice parameter have no effect, whereas a denser mesh or wider smearing removes the imaginary modes. They are an artefact of under-sampling the nested Fermi surface of Cr, not a dynamical instability.\relax }{figure.caption.44}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S27}{\ignorespaces Our phonons against experiment. (a) Fe by finite displacements at the experimental (solid) and PBE-relaxed (dashed) lattice parameter, with the room-temperature neutron dispersion of Minkiewicz \textit  {et al.}\ \cite  {minkiewicz1967phonon}; (b) non-magnetic Cr (DFPT, $k=24^3$) with the 300 K neutron data of Shaw and Muhlestein \cite  {shaw1971investigation}; (c) Fe phonon DOS against nuclear inelastic scattering at 30 and 300 K (Mauger \textit  {et al.}\ \cite  {mauger2014nonharmonic}) and the force-constant DOS of Fultz \textit  {et al.}\ \cite  {fultz1995phonon}; (d) Cr phonon DOS (NM and AFM) against Fultz \textit  {et al.} Agreement (nearest-branch RMS deviation from the neutron data; mean frequency against the reference DOS): Fe 0.23 THz and $-0.1\%$ at the experimental lattice parameter, 0.46 THz and $+7.8\%$ at the relaxed one; Cr 0.41 THz (NM) and 0.35 THz (AFM), $+6\%$ and $+3\%$. Fe phonons are computed by finite displacements (phonopy; 0.01 \r A\ displacement in a cubic $3\times 3\times 3$ conventional supercell of 54 atoms, same PBE-PAW settings, $k=5^3$), because density-functional perturbation theory (QE \texttt  {ph.x}) gave frequencies about 60\% too high for ferromagnetic Fe while a frozen phonon with identical settings agreed with neutron scattering to 2\% (4.40 vs 4.31 THz for the transverse mode at $\zeta =1/3$ along $\Gamma $--H). A $2\times 2\times 5$ supercell was not used: its tetragonal shape made the symmetrised force constants inconsistent and produced a spurious imaginary branch.\relax }}{33}{figure.caption.45}\protected@file@percent }
\newlabel{fig:S_phonons_exp}{{S27}{33}{Our phonons against experiment. (a) Fe by finite displacements at the experimental (solid) and PBE-relaxed (dashed) lattice parameter, with the room-temperature neutron dispersion of Minkiewicz \textit {et al.}\ \cite {minkiewicz1967phonon}; (b) non-magnetic Cr (DFPT, $k=24^3$) with the 300 K neutron data of Shaw and Muhlestein \cite {shaw1971investigation}; (c) Fe phonon DOS against nuclear inelastic scattering at 30 and 300 K (Mauger \textit {et al.}\ \cite {mauger2014nonharmonic}) and the force-constant DOS of Fultz \textit {et al.}\ \cite {fultz1995phonon}; (d) Cr phonon DOS (NM and AFM) against Fultz \textit {et al.} Agreement (nearest-branch RMS deviation from the neutron data; mean frequency against the reference DOS): Fe 0.23 THz and $-0.1\%$ at the experimental lattice parameter, 0.46 THz and $+7.8\%$ at the relaxed one; Cr 0.41 THz (NM) and 0.35 THz (AFM), $+6\%$ and $+3\%$. Fe phonons are computed by finite displacements (phonopy; 0.01 \AA \ displacement in a cubic $3\times 3\times 3$ conventional supercell of 54 atoms, same PBE-PAW settings, $k=5^3$), because density-functional perturbation theory (QE \texttt {ph.x}) gave frequencies about 60\% too high for ferromagnetic Fe while a frozen phonon with identical settings agreed with neutron scattering to 2\% (4.40 vs 4.31 THz for the transverse mode at $\zeta =1/3$ along $\Gamma $--H). A $2\times 2\times 5$ supercell was not used: its tetragonal shape made the symmetrised force constants inconsistent and produced a spurious imaginary branch.\relax }{figure.caption.45}{}}
