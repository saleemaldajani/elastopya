\newlabel{fig:S_fermi_pure}{{S16}{24}{Fermi-surface sections ($k_z=0$) of \textit {bcc} Fe (FM; solid, majority; dashed, minority), \textit {bcc} Cr (NM) and commensurate AFM Cr (folded simple-cubic zone; both spin channels coincide). The nested electron and hole sheets of Cr are responsible for its incommensurate spin-density wave.\relax }{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S17}{\ignorespaces Electronic band structures of \textit  {bcc} Fe (FM), \textit  {bcc} Cr (NM) and AFM Cr (simple-cubic path), Quantum ESPRESSO. Validation: along $\Gamma $--H the Fe bands within $\pm 2.7$ eV of $E_{\mathrm  F}$ agree with the EMTO-CPA spectrum of pure Fe (Korzhavyi \textit  {et al.}\ \cite  {korzhavyi2009electronic}, Fig.\nobreakspace  {}7) to an RMS of 0.22 eV (spin up) and 0.17 eV (spin down); the band crossings at $E_{\mathrm  F}$ and the H-point level 0.15 eV above $E_{\mathrm  F}$ in the majority channel coincide.\relax }}{24}{figure.caption.33}\protected@file@percent }
\newlabel{fig:S_bands_pure}{{S17}{24}{Electronic band structures of \textit {bcc} Fe (FM), \textit {bcc} Cr (NM) and AFM Cr (simple-cubic path), Quantum ESPRESSO. Validation: along $\Gamma $--H the Fe bands within $\pm 2.7$ eV of $E_{\mathrm F}$ agree with the EMTO-CPA spectrum of pure Fe (Korzhavyi \textit {et al.}\ \cite {korzhavyi2009electronic}, Fig.~7) to an RMS of 0.22 eV (spin up) and 0.17 eV (spin down); the band crossings at $E_{\mathrm F}$ and the H-point level 0.15 eV above $E_{\mathrm F}$ in the majority channel coincide.\relax }{figure.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S18}{\ignorespaces Electronic band structures of \textit  {bcc} Fe (FM), \textit  {bcc} Cr (NM) and AFM Cr at the room-temperature experimental lattice parameters (Fe 2.8665 \r A, Cr 2.8846 \r A), for comparison with Fig.\nobreakspace  {}\ref  {fig:S_bands_pure} at the relaxed PBE lattice parameters. Validation: the Fe $\Gamma $--H bands agree with EMTO-CPA \cite  {korzhavyi2009electronic} to an RMS of 0.18 eV (spin up) and 0.14 eV (spin down), slightly better than at the relaxed lattice parameter.\relax }}{25}{figure.caption.34}\protected@file@percent }
\newlabel{fig:S_bands_aexp}{{S18}{25}{Electronic band structures of \textit {bcc} Fe (FM), \textit {bcc} Cr (NM) and AFM Cr at the room-temperature experimental lattice parameters (Fe 2.8665 \AA , Cr 2.8846 \AA ), for comparison with Fig.~\ref {fig:S_bands_pure} at the relaxed PBE lattice parameters. Validation: the Fe $\Gamma $--H bands agree with EMTO-CPA \cite {korzhavyi2009electronic} to an RMS of 0.18 eV (spin up) and 0.14 eV (spin down), slightly better than at the relaxed lattice parameter.\relax }{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S19}{\ignorespaces Unfolded Fermi surfaces (Bloch spectral function at $E_{\mathrm  F}$, $k_z=0$; spin up top, spin down bottom) of the 40-atom SQS, in the layout of Korzhavyi \textit  {et al.}\ \cite  {korzhavyi2009electronic} (their Fig.\nobreakspace  {}6). Top: 0, 5 and 10\% Cr at the experimental lattice parameter. Bottom: 0, 5 and 10\% Cr at the PBE-relaxed lattice parameter. The supercell bands were unfolded onto the \textit  {bcc} zone with BandUPpy (band step with ParO diagonalisation), on a 61$\times $61 grid except for the relaxed 5 and 10\% Cr panels (41$\times $41, hence coarser pixels). Pure Fe reproduces the Fermi surface of the primitive cell (Fig.\nobreakspace  {}\ref  {fig:S_fermi_Fe}) at both lattice parameters. With Cr the spin-up sheet changes topology: the arms that connect the H pockets through N lose their weight and the $\Gamma $-centred sheet reaches N. The change is already clear at 5\% Cr at both lattice parameters, and 10\% Cr looks the same with more disorder broadening, while the spin-down sheets barely change. This is the spin-up topology change that Ref.\nobreakspace  {}\cite  {korzhavyi2009electronic} places between 5 and 10\% Cr, the electronic origin of the Fe-rich elastic anomaly (Fig.\nobreakspace  {}\ref  {fig:S_fe_rich}); in our SQS it sets in slightly earlier, consistent with the critical level of Fig.\nobreakspace  {}\ref  {fig:S_ett}a reaching $E_{\mathrm  F}$ at 5\% Cr.\relax }}{26}{figure.caption.35}\protected@file@percent }
\newlabel{fig:S_fermi_unfolded}{{S19}{26}{Unfolded Fermi surfaces (Bloch spectral function at $E_{\mathrm F}$, $k_z=0$; spin up top, spin down bottom) of the 40-atom SQS, in the layout of Korzhavyi \textit {et al.}\ \cite {korzhavyi2009electronic} (their Fig.~6). Top: 0, 5 and 10\% Cr at the experimental lattice parameter. Bottom: 0, 5 and 10\% Cr at the PBE-relaxed lattice parameter. The supercell bands were unfolded onto the \textit {bcc} zone with BandUPpy (band step with ParO diagonalisation), on a 61$\times $61 grid except for the relaxed 5 and 10\% Cr panels (41$\times $41, hence coarser pixels). Pure Fe reproduces the Fermi surface of the primitive cell (Fig.~\ref {fig:S_fermi_Fe}) at both lattice parameters. With Cr the spin-up sheet changes topology: the arms that connect the H pockets through N lose their weight and the $\Gamma $-centred sheet reaches N. The change is already clear at 5\% Cr at both lattice parameters, and 10\% Cr looks the same with more disorder broadening, while the spin-down sheets barely change. This is the spin-up topology change that Ref.~\cite {korzhavyi2009electronic} places between 5 and 10\% Cr, the electronic origin of the Fe-rich elastic anomaly (Fig.~\ref {fig:S_fe_rich}); in our SQS it sets in slightly earlier, consistent with the critical level of Fig.~\ref {fig:S_ett}a reaching $E_{\mathrm F}$ at 5\% Cr.\relax }{figure.caption.35}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S20}{\ignorespaces Unfolded (effective) band structure of the 40-atom SQS of pure Fe along $\Gamma $--H--N--$\Gamma $--P--H, spin up (top) and down (bottom), Lorentzian-broadened by 0.06 eV. It reproduces the primitive-cell bands (Fig.\nobreakspace  {}\ref  {fig:S_bands_pure}), including the majority H level 0.15 eV above $E_{\mathrm  F}$, which validates the unfolding before it is applied to the alloys (Fig.\nobreakspace  {}\ref  {fig:S_bands_unfolded_aexp}).\relax }}{27}{figure.caption.36}\protected@file@percent }
\newlabel{fig:S_bands_unfolded}{{S20}{27}{Unfolded (effective) band structure of the 40-atom SQS of pure Fe along $\Gamma $--H--N--$\Gamma $--P--H, spin up (top) and down (bottom), Lorentzian-broadened by 0.06 eV. It reproduces the primitive-cell bands (Fig.~\ref {fig:S_bands_pure}), including the majority H level 0.15 eV above $E_{\mathrm F}$, which validates the unfolding before it is applied to the alloys (Fig.~\ref {fig:S_bands_unfolded_aexp}).\relax }{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S21}{\ignorespaces Unfolded band structures of the 40-atom SQS at 0, 5 and 10\% Cr at the experimental lattice parameter, spin up (top) and down (bottom), as in Fig.\nobreakspace  {}\ref  {fig:S_bands_unfolded}. The 0\% Cr cell reproduces the primitive-cell bands of Fig.\nobreakspace  {}\ref  {fig:S_bands_aexp}. Cr broadens the bands (disorder) and moves the majority level at H from 0.104 eV above $E_{\mathrm  F}$ (0\%) to 0.005 eV above (5\%) and 0.009 eV below (10\%), with a disorder spread of about 0.1 eV; these are the points of Fig.\nobreakspace  {}\ref  {fig:S_ett}a.\relax }}{28}{figure.caption.37}\protected@file@percent }
\newlabel{fig:S_bands_unfolded_aexp}{{S21}{28}{Unfolded band structures of the 40-atom SQS at 0, 5 and 10\% Cr at the experimental lattice parameter, spin up (top) and down (bottom), as in Fig.~\ref {fig:S_bands_unfolded}. The 0\% Cr cell reproduces the primitive-cell bands of Fig.~\ref {fig:S_bands_aexp}. Cr broadens the bands (disorder) and moves the majority level at H from 0.104 eV above $E_{\mathrm F}$ (0\%) to 0.005 eV above (5\%) and 0.009 eV below (10\%), with a disorder spread of about 0.1 eV; these are the points of Fig.~\ref {fig:S_ett}a.\relax }{figure.caption.37}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S22}{\ignorespaces Unfolded band structures of the 40-atom SQS at 0, 5 and 10\% Cr at the PBE-relaxed lattice parameter, spin up (top) and down (bottom), as in Fig.\nobreakspace  {}\ref  {fig:S_bands_unfolded_aexp}. The majority level at H lies 0.149 eV above $E_{\mathrm  F}$ at 0\%\nobreakspace  {}Cr and 0.065 and 0.068 eV above it at 5 and 10\%\nobreakspace  {}Cr, with disorder spreads of 0.12 and 0.11 eV; these are the relaxed-lattice points of Fig.\nobreakspace  {}\ref  {fig:S_ett}a.\relax }}{29}{figure.caption.38}\protected@file@percent }
\newlabel{fig:S_bands_unfolded_relaxed}{{S22}{29}{Unfolded band structures of the 40-atom SQS at 0, 5 and 10\% Cr at the PBE-relaxed lattice parameter, spin up (top) and down (bottom), as in Fig.~\ref {fig:S_bands_unfolded_aexp}. The majority level at H lies 0.149 eV above $E_{\mathrm F}$ at 0\%~Cr and 0.065 and 0.068 eV above it at 5 and 10\%~Cr, with disorder spreads of 0.12 and 0.11 eV; these are the relaxed-lattice points of Fig.~\ref {fig:S_ett}a.\relax }{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S23}{\ignorespaces Fe- and Cr-projected densities of states per atom of the relaxed 40-atom SQS (spin up above, spin down below the axis), in the layout of Korzhavyi \textit  {et al.}\ \cite  {korzhavyi2009electronic} (their Fig.\nobreakspace  {}4). Validation: the Fermi-level DOS, 0.79--0.98 states/eV/atom at 20--95\% Cr, lies 9--21\% below the EMTO-CPA ferromagnetic values of Ref.\nobreakspace  {}\cite  {korzhavyi2009electronic} (their Fig.\nobreakspace  {}3d) and follows the same composition trend; the average site moments agree with EMTO-CPA (their Fig.\nobreakspace  {}8) to 0.08 $\mu _{\mathrm  B}$ for Fe and 0.07 $\mu _{\mathrm  B}$ for Cr, and lie within the spread of VASP supercell values of Klaver \textit  {et al.}\ \cite  {klaver2006magnetism}. The energy window extends to 4 eV above $E_{\mathrm  F}$ (1.6 times the occupied bands).\relax }}{29}{figure.caption.39}\protected@file@percent }
\newlabel{fig:S_dos}{{S23}{29}{Fe- and Cr-projected densities of states per atom of the relaxed 40-atom SQS (spin up above, spin down below the axis), in the layout of Korzhavyi \textit {et al.}\ \cite {korzhavyi2009electronic} (their Fig.~4). Validation: the Fermi-level DOS, 0.79--0.98 states/eV/atom at 20--95\% Cr, lies 9--21\% below the EMTO-CPA ferromagnetic values of Ref.~\cite {korzhavyi2009electronic} (their Fig.~3d) and follows the same composition trend; the average site moments agree with EMTO-CPA (their Fig.~8) to 0.08 $\mu _{\mathrm B}$ for Fe and 0.07 $\mu _{\mathrm B}$ for Cr, and lie within the spread of VASP supercell values of Klaver \textit {et al.}\ \cite {klaver2006magnetism}. The energy window extends to 4 eV above $E_{\mathrm F}$ (1.6 times the occupied bands).\relax }{figure.caption.39}{}}
