\@writefile{lof}{\contentsline {figure}{\numberline {S39}{\ignorespaces Nesting function $\xi (\mathbf  q)=N^{-1}\DOTSB \sum@ \slimits@ _{\mathbf  k,n,m}\delta (\varepsilon _{n\mathbf  k}-E_{\mathrm  F})\,\delta (\varepsilon _{m,\mathbf  k+\mathbf  q}-E_{\mathrm  F})$ of non-magnetic \textit  {bcc} Cr along $\Gamma $--H (QE bands on the full $36^3$ grid, unfolded from the irreducible wedge with the 48 operations of $O_h$; Gaussian width 0.05 eV), normalised to its pure-Cr maximum, for pure Cr and with 5, 10 and 20\% Fe added as a rigid-band filling (2 electrons per Fe). Pure Cr peaks at $q=0.945\,(2\pi /a)$, against the measured SDW wavevector $Q=0.952$ ($\delta =0.048$ at low temperature \cite  {fawcett1988spin}). With Fe the incommensurate peak disappears and the maximum moves to the commensurate $q=1$ (H) by 5\% Fe, consistent with the measured incommensurate-to-commensurate transition of the SDW at about 2.3 at.\% Fe \cite  {fawcett1988spin}.\relax }}{44}{figure.caption.61}\protected@file@percent }
\newlabel{fig:S_nesting}{{S39}{44}{Nesting function $\xi (\mathbf q)=N^{-1}\sum _{\mathbf k,n,m}\delta (\varepsilon _{n\mathbf k}-E_{\mathrm F})\,\delta (\varepsilon _{m,\mathbf k+\mathbf q}-E_{\mathrm F})$ of non-magnetic \textit {bcc} Cr along $\Gamma $--H (QE bands on the full $36^3$ grid, unfolded from the irreducible wedge with the 48 operations of $O_h$; Gaussian width 0.05 eV), normalised to its pure-Cr maximum, for pure Cr and with 5, 10 and 20\% Fe added as a rigid-band filling (2 electrons per Fe). Pure Cr peaks at $q=0.945\,(2\pi /a)$, against the measured SDW wavevector $Q=0.952$ ($\delta =0.048$ at low temperature \cite {fawcett1988spin}). With Fe the incommensurate peak disappears and the maximum moves to the commensurate $q=1$ (H) by 5\% Fe, consistent with the measured incommensurate-to-commensurate transition of the SDW at about 2.3 at.\% Fe \cite {fawcett1988spin}.\relax }{figure.caption.61}{}}
