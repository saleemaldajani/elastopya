\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces Convergence of the Quantum ESPRESSO elastic constants of \textit  {bcc} Fe (2-atom cell) with Brillouin-zone sampling. (a) $C_{11}$, $C_{12}$ and $C_{44}$ at 60\nobreakspace  {}Ry from the $2\times 2\times 5$ mesh, which is equivalent to $\Gamma $-only sampling of the 40-atom SQS, to $20^3$; open squares, 80\nobreakspace  {}Ry at $16^3$; bars at right, the present VASP tensor. (b) Fe moment for the same meshes.\relax }}{18}{figure.caption.20}\protected@file@percent }
\newlabel{fig:S_convergence}{{S8}{18}{Convergence of the Quantum ESPRESSO elastic constants of \textit {bcc} Fe (2-atom cell) with Brillouin-zone sampling. (a) $C_{11}$, $C_{12}$ and $C_{44}$ at 60~Ry from the $2\times 2\times 5$ mesh, which is equivalent to $\Gamma $-only sampling of the 40-atom SQS, to $20^3$; open squares, 80~Ry at $16^3$; bars at right, the present VASP tensor. (b) Fe moment for the same meshes.\relax }{figure.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Structural convergence of the Quantum ESPRESSO relaxations (40-atom SQS). Residual total force and pressure at the last ionic step, and number of ionic (BFGS) steps. Thresholds: energy change $10^{-5}$\nobreakspace  {}Ry, force components $10^{-3}$\nobreakspace  {}Ry/bohr, pressure 0.2\nobreakspace  {}kbar for the PBE-relaxed cells; at the experimental lattice parameter the cell is fixed and only the ions relax, hence the non-zero pressure. The SCF threshold is $10^{-8}$\nobreakspace  {}Ry, except $3\times 10^{-6}$\nobreakspace  {}Ry for the last 19 of the 21 ionic steps of Fe--65Cr at the experimental lattice parameter, where the SCF reached a $10^{-6}$\nobreakspace  {}Ry noise floor (energy error below 1\nobreakspace  {}$\mu $eV/atom). Every SCF of every ionic step converged.\relax }}{19}{table.caption.21}\protected@file@percent }
\newlabel{tab:S_structural_convergence}{{S1}{19}{Structural convergence of the Quantum ESPRESSO relaxations (40-atom SQS). Residual total force and pressure at the last ionic step, and number of ionic (BFGS) steps. Thresholds: energy change $10^{-5}$~Ry, force components $10^{-3}$~Ry/bohr, pressure 0.2~kbar for the PBE-relaxed cells; at the experimental lattice parameter the cell is fixed and only the ions relax, hence the non-zero pressure. The SCF threshold is $10^{-8}$~Ry, except $3\times 10^{-6}$~Ry for the last 19 of the 21 ionic steps of Fe--65Cr at the experimental lattice parameter, where the SCF reached a $10^{-6}$~Ry noise floor (energy error below 1~$\mu $eV/atom). Every SCF of every ionic step converged.\relax }{table.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces Structural convergence of the Quantum ESPRESSO relaxations of Table\nobreakspace  {}\ref  {tab:S_structural_convergence}. (a) Total energy relative to its final value against ionic (BFGS) step, coloured by $x_{\mathrm  {Cr}}$; solid, PBE-relaxed cell; dashed, experimental lattice parameter with ions relaxed. Dotted line: the $10^{-5}$\nobreakspace  {}Ry energy threshold per 40-atom cell. Resumed runs are shown as one continuous sequence. (b) Residual total force at the last ionic step.\relax }}{19}{figure.caption.22}\protected@file@percent }
\newlabel{fig:S_structural_convergence}{{S9}{19}{Structural convergence of the Quantum ESPRESSO relaxations of Table~\ref {tab:S_structural_convergence}. (a) Total energy relative to its final value against ionic (BFGS) step, coloured by $x_{\mathrm {Cr}}$; solid, PBE-relaxed cell; dashed, experimental lattice parameter with ions relaxed. Dotted line: the $10^{-5}$~Ry energy threshold per 40-atom cell. Resumed runs are shown as one continuous sequence. (b) Residual total force at the last ionic step.\relax }{figure.caption.22}{}}
