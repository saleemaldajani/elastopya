\@writefile{lof}{\contentsline {figure}{\numberline {S28}{\ignorespaces Spin-resolved total density of states of the pure metals (QE, optimised tetrahedra, $36^3$ mesh for the \textit  {bcc} cells and $24^3$ for the 2-atom AFM Cr cell) at the PBE-relaxed (solid) and experimental (dashed) lattice parameter; spin down is plotted downwards, and the two channels of non-magnetic Cr are equal. (a) Fe, with the EMTO-CPA DOS of the Fe site in Fe$_{98}$Cr$_2$ (dots, digitized from Fig.\nobreakspace  {}4 of Ref.\nobreakspace  {}\cite  {korzhavyi2009electronic}). $N(E_{\mathrm  F})$ of Fe is 0.74 (spin up) and 0.24 (spin down) states/eV against 0.69 and 0.29 there, and the main majority and minority peaks lie 0.2--0.3 eV further from $E_{\mathrm  F}$ in PBE than in the LDA of Ref.\nobreakspace  {}\cite  {korzhavyi2009electronic}. Total $N(E_{\mathrm  F})$: 0.98 (Fe), 0.68 (non-magnetic Cr) and 0.30 (AFM Cr) states/eV/atom at the PBE-relaxed lattice parameter, within 0.07 at the experimental one. With the measured electronic specific-heat coefficients (Fe 4.98, Cr 1.40 mJ\,mol$^{-1}$\,K$^{-2}$ \cite  {kittel2005introduction}) these imply a mass enhancement $1+\lambda \approx 2.0$--2.2 for FM Fe and AFM Cr, whereas non-magnetic Cr would require $1+\lambda <1$.\relax }}{35}{figure.caption.48}\protected@file@percent }
\newlabel{fig:S_dos_pure}{{S28}{35}{Spin-resolved total density of states of the pure metals (QE, optimised tetrahedra, $36^3$ mesh for the \textit {bcc} cells and $24^3$ for the 2-atom AFM Cr cell) at the PBE-relaxed (solid) and experimental (dashed) lattice parameter; spin down is plotted downwards, and the two channels of non-magnetic Cr are equal. (a) Fe, with the EMTO-CPA DOS of the Fe site in Fe$_{98}$Cr$_2$ (dots, digitized from Fig.~4 of Ref.~\cite {korzhavyi2009electronic}). $N(E_{\mathrm F})$ of Fe is 0.74 (spin up) and 0.24 (spin down) states/eV against 0.69 and 0.29 there, and the main majority and minority peaks lie 0.2--0.3 eV further from $E_{\mathrm F}$ in PBE than in the LDA of Ref.~\cite {korzhavyi2009electronic}. Total $N(E_{\mathrm F})$: 0.98 (Fe), 0.68 (non-magnetic Cr) and 0.30 (AFM Cr) states/eV/atom at the PBE-relaxed lattice parameter, within 0.07 at the experimental one. With the measured electronic specific-heat coefficients (Fe 4.98, Cr 1.40 mJ\,mol$^{-1}$\,K$^{-2}$ \cite {kittel2005introduction}) these imply a mass enhancement $1+\lambda \approx 2.0$--2.2 for FM Fe and AFM Cr, whereas non-magnetic Cr would require $1+\lambda <1$.\relax }{figure.caption.48}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S29}{\ignorespaces Bulk modulus against experiment. Markers: measured values compiled by Korzhavyi \textit  {et al.}\ \cite  {korzhavyi2009electronic} (RT and LT; FM, AFM and paramagnetic); grey line: their EMTO-CPA FM calculation. QE SQS (diamonds) and pure elements (squares; 2-atom cells, $k=16^3$, Fe FM and Cr AFM) at the PBE-relaxed (open) and the room-temperature experimental (filled) lattice parameter; VASP (circles). At the relaxed volume both codes overestimate $B$: QE by $+28\%$ (Fe) and $+31\%$ (95\% Cr), VASP by $+32\%$ (Fe). At the experimental lattice parameter QE gives $B=170$ GPa for Fe ($+1\%$ against 168 GPa), $-7\%$ for AFM Cr and $+7\%$ at 95\% Cr. The experimental lattice parameter was therefore adopted for the additional QE series of Section S4; PBE underestimates the Fe--Cr volume by about 4\%, and the bulk modulus is the property most sensitive to it.\relax }}{36}{figure.caption.50}\protected@file@percent }
\newlabel{fig:V_bulk}{{S29}{36}{Bulk modulus against experiment. Markers: measured values compiled by Korzhavyi \textit {et al.}\ \cite {korzhavyi2009electronic} (RT and LT; FM, AFM and paramagnetic); grey line: their EMTO-CPA FM calculation. QE SQS (diamonds) and pure elements (squares; 2-atom cells, $k=16^3$, Fe FM and Cr AFM) at the PBE-relaxed (open) and the room-temperature experimental (filled) lattice parameter; VASP (circles). At the relaxed volume both codes overestimate $B$: QE by $+28\%$ (Fe) and $+31\%$ (95\% Cr), VASP by $+32\%$ (Fe). At the experimental lattice parameter QE gives $B=170$ GPa for Fe ($+1\%$ against 168 GPa), $-7\%$ for AFM Cr and $+7\%$ at 95\% Cr. The experimental lattice parameter was therefore adopted for the additional QE series of Section S4; PBE underestimates the Fe--Cr volume by about 4\%, and the bulk modulus is the property most sensitive to it.\relax }{figure.caption.50}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S30}{\ignorespaces Average Fe and Cr site moments of the QE SQS (error bars: standard deviation over sites) at the relaxed (filled) and experimental (open) lattice parameter, against EMTO-CPA FM (lines; Korzhavyi \textit  {et al.}\ \cite  {korzhavyi2009electronic}, Fig.\nobreakspace  {}8, $a_0=2.875$ \r A) and VASP supercells (crosses; Klaver \textit  {et al.}\ \cite  {klaver2006magnetism}). The collapse of the Cr moment between 20 and 50\% Cr is reproduced.\relax }}{36}{figure.caption.51}\protected@file@percent }
\newlabel{fig:V_moments}{{S30}{36}{Average Fe and Cr site moments of the QE SQS (error bars: standard deviation over sites) at the relaxed (filled) and experimental (open) lattice parameter, against EMTO-CPA FM (lines; Korzhavyi \textit {et al.}\ \cite {korzhavyi2009electronic}, Fig.~8, $a_0=2.875$ \AA ) and VASP supercells (crosses; Klaver \textit {et al.}\ \cite {klaver2006magnetism}). The collapse of the Cr moment between 20 and 50\% Cr is reproduced.\relax }{figure.caption.51}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S31}{\ignorespaces Fermi-level density of states per atom of the relaxed QE SQS (total and spin down, averaged over $\pm 0.1$ eV) against EMTO-CPA for the FM and paramagnetic (DLM) states (Korzhavyi \textit  {et al.}\ \cite  {korzhavyi2009electronic}, Fig.\nobreakspace  {}3d). The QE values are 9--21\% lower and follow the FM composition trend.\relax }}{37}{figure.caption.52}\protected@file@percent }
\newlabel{fig:V_nef}{{S31}{37}{Fermi-level density of states per atom of the relaxed QE SQS (total and spin down, averaged over $\pm 0.1$ eV) against EMTO-CPA for the FM and paramagnetic (DLM) states (Korzhavyi \textit {et al.}\ \cite {korzhavyi2009electronic}, Fig.~3d). The QE values are 9--21\% lower and follow the FM composition trend.\relax }{figure.caption.52}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S32}{\ignorespaces Band structure of FM \textit  {bcc} Fe along $\Gamma $--H, majority (left) and minority (right), QE at the relaxed and experimental lattice parameters, against the EMTO-CPA spectrum of pure Fe (points; Korzhavyi \textit  {et al.}\ \cite  {korzhavyi2009electronic}, Fig.\nobreakspace  {}7a,d; lattice parameter not stated). RMS deviations 0.14--0.22 eV; the Fermi-level crossings and the majority H level 0.15 eV above $E_{\mathrm  F}$ agree.\relax }}{37}{figure.caption.53}\protected@file@percent }
