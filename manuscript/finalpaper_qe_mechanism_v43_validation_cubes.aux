\@writefile{lof}{\contentsline {figure}{\numberline {S11}{\ignorespaces QE 40-atom SQS and pure elements at the PBE-relaxed (open, dashed) and the room-temperature experimental (filled) lattice parameter, against EMTO-CPA \cite  {razumovskiy2011first}: (a) $f_{\mathrm  {SAW}}$ at $\lambda =6.4\,\mu $m, (b) bulk modulus, (c) VRH shear modulus. The shaded band marks 30--40\%\nobreakspace  {}Cr. Pure Cr is AFM; Fe--80Cr at the experimental lattice parameter converged to a ferrimagnetic state.\relax }}{21}{figure.caption.25}\protected@file@percent }
\newlabel{fig:S_qe_aexp}{{S11}{21}{QE 40-atom SQS and pure elements at the PBE-relaxed (open, dashed) and the room-temperature experimental (filled) lattice parameter, against EMTO-CPA \cite {razumovskiy2011first}: (a) $f_{\mathrm {SAW}}$ at $\lambda =6.4\,\mu $m, (b) bulk modulus, (c) VRH shear modulus. The shaded band marks 30--40\%~Cr. Pure Cr is AFM; Fe--80Cr at the experimental lattice parameter converged to a ferrimagnetic state.\relax }{figure.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S12}{\ignorespaces Spinodal window implied by the QE enthalpies of mixing. (a) QE $\Delta H_{\mathrm  {mix}}$ of the 40-atom SQS at the PBE-relaxed (circles) and experimental (diamonds) lattice parameter, with three-term (dashed) and four-term (solid) Redlich--Kister fits. (b) Demixing curvature $\partial ^2\Delta G_{\mathrm  {demix}}/\partial x^2$ at 748\nobreakspace  {}K from each fit with the ideal configurational entropy; positive values are spinodally unstable. Grey band: CALPHAD chemical spinodal at 748\nobreakspace  {}K \cite  {xiong2011improved}; dotted line: Fe--36Cr. The lower edge of the QE window moves from 0.23 to 0.34--0.37 with the fit order; the upper edge (0.96--0.99) reflects the 0\nobreakspace  {}K ferromagnetic reference. Script: \texttt  {scripts/make\_qe\_spinodal\_sm.py}.\relax }}{21}{figure.caption.26}\protected@file@percent }
\newlabel{fig:S_qe_spinodal}{{S12}{21}{Spinodal window implied by the QE enthalpies of mixing. (a) QE $\Delta H_{\mathrm {mix}}$ of the 40-atom SQS at the PBE-relaxed (circles) and experimental (diamonds) lattice parameter, with three-term (dashed) and four-term (solid) Redlich--Kister fits. (b) Demixing curvature $\partial ^2\Delta G_{\mathrm {demix}}/\partial x^2$ at 748~K from each fit with the ideal configurational entropy; positive values are spinodally unstable. Grey band: CALPHAD chemical spinodal at 748~K \cite {xiong2011improved}; dotted line: Fe--36Cr. The lower edge of the QE window moves from 0.23 to 0.34--0.37 with the fit order; the upper edge (0.96--0.99) reflects the 0~K ferromagnetic reference. Script: \texttt {scripts/make\_qe\_spinodal\_sm.py}.\relax }{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S13}{\ignorespaces Validation of the MD procedures against Ref.\nobreakspace  {}\cite  {al2023detecting}. (a) Bulk modulus of Fe$_{50}$Cr$_{50}$ against spinodal conversion fraction: the published $50^3$ series (10 alloys) and the present $25^3$ series (5 alloys, mean $\pm $ s.d.); $C_{11}$ at $\phi =1$ is 266.3 against 266.0\nobreakspace  {}GPa. (b) $C_{11}$ of the present MD random alloys across composition, with the published equiatomic random-alloy value.\relax }}{22}{figure.caption.28}\protected@file@percent }
\newlabel{fig:S_md_validation}{{S13}{22}{Validation of the MD procedures against Ref.~\cite {al2023detecting}. (a) Bulk modulus of Fe$_{50}$Cr$_{50}$ against spinodal conversion fraction: the published $50^3$ series (10 alloys) and the present $25^3$ series (5 alloys, mean $\pm $ s.d.); $C_{11}$ at $\phi =1$ is 266.3 against 266.0~GPa. (b) $C_{11}$ of the present MD random alloys across composition, with the published equiatomic random-alloy value.\relax }{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S14}{\ignorespaces MD stiffening on full decomposition across composition ($25^3$ cells, five alloys per composition). (a) Relative change of $f_{\mathrm  {SAW}}$ between the random ($\phi =0.5$) and fully decomposed ($\phi =1$) states at twelve compositions, with the spinodal windows shaded. (b) Highest (P)SAW frequency over $10^4$ grains for the random and decomposed MD tensors: decomposition never reaches the unallowed band.\relax }}{22}{figure.caption.29}\protected@file@percent }
\newlabel{fig:S_md_decomposition}{{S14}{22}{MD stiffening on full decomposition across composition ($25^3$ cells, five alloys per composition). (a) Relative change of $f_{\mathrm {SAW}}$ between the random ($\phi =0.5$) and fully decomposed ($\phi =1$) states at twelve compositions, with the spinodal windows shaded. (b) Highest (P)SAW frequency over $10^4$ grains for the random and decomposed MD tensors: decomposition never reaches the unallowed band.\relax }{figure.caption.29}{}}
