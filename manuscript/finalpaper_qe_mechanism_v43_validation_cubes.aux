\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces Fe-rich elastic constants ($x_{\mathrm  {Cr}}\leq 0.2$): bulk modulus $B$, $C_{44}$ and $C'$ from EMTO-CPA \cite  {razumovskiy2011first}, MD (EAM) random alloys on a 1\% composition grid, and the present VASP and Quantum ESPRESSO calculations. Validation against measured bulk moduli (compiled in Ref.\nobreakspace  {}\cite  {korzhavyi2009electronic}): at the relaxed PBE volume both DFT codes overestimate $B$ (VASP: Fe 221 vs 168 GPa, $+32\%$; QE SQS at 95\% Cr: $+31\%$ against the paramagnetic value), the usual consequence of the too-small PBE volume of Fe--Cr; at the room-temperature experimental lattice parameter the QE value at 95\% Cr is within 7\%. The shaded band (0.08--0.12) marks the composition range of the Fermi-surface topology change reported in Ref.\nobreakspace  {}\cite  {razumovskiy2011first}; the classical potential has no electronic structure and does not reproduce it.\relax }}{20}{figure.caption.24}\protected@file@percent }
\newlabel{fig:S_fe_rich}{{S10}{20}{Fe-rich elastic constants ($x_{\mathrm {Cr}}\leq 0.2$): bulk modulus $B$, $C_{44}$ and $C'$ from EMTO-CPA \cite {razumovskiy2011first}, MD (EAM) random alloys on a 1\% composition grid, and the present VASP and Quantum ESPRESSO calculations. Validation against measured bulk moduli (compiled in Ref.~\cite {korzhavyi2009electronic}): at the relaxed PBE volume both DFT codes overestimate $B$ (VASP: Fe 221 vs 168 GPa, $+32\%$; QE SQS at 95\% Cr: $+31\%$ against the paramagnetic value), the usual consequence of the too-small PBE volume of Fe--Cr; at the room-temperature experimental lattice parameter the QE value at 95\% Cr is within 7\%. The shaded band (0.08--0.12) marks the composition range of the Fermi-surface topology change reported in Ref.~\cite {razumovskiy2011first}; the classical potential has no electronic structure and does not reproduce it.\relax }{figure.caption.24}{}}
