&control
  calculation = 'scf', prefix = 'fs', outdir = './tmp', pseudo_dir = '/orcd/pool/004/sdajani/fecr_qe/pseudo'
/
&system
  ibrav = 3, celldm(1) = 5.385719, nat = 1, ntyp = 1,
  ecutwfc = 60, ecutrho = 480, occupations = 'smearing', smearing = 'mv', degauss = 0.02,
  nspin = 1, nbnd = 16
/
