&control
  calculation = 'scf', prefix = 'fs', outdir = './tmp', pseudo_dir = '/orcd/pool/004/sdajani/fecr_qe/pseudo'
/
&system
  ibrav = 1, celldm(1) = 5.423514, nat = 2, ntyp = 2,
  ecutwfc = 60, ecutrho = 480, occupations = 'smearing', smearing = 'mv', degauss = 0.02,
  nspin = 2, nbnd = 28
  starting_magnetization(1) = 0.5
  starting_magnetization(2) = -0.5
/
&electrons
  conv_thr = 1e-9, mixing_beta = 0.3
/
ATOMIC_SPECIES
Cr1 51.996 Cr.pbe-spn-kjpaw_psl.1.0.0.UPF
Cr2 51.996 Cr.pbe-spn-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS alat
Cr1 0 0 0
Cr2 0.5 0.5 0.5
K_POINTS automatic
12 12 12 0 0 0
